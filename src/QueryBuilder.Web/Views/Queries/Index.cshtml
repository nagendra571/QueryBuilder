@model IEnumerable<QueryBuilder.Web.Models.Queries.QueryListItemViewModel>

@{
    ViewData["Title"] = "Queries";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Queries</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
    {
        <a class="btn btn-primary" asp-action="Create">New Query</a>
    }
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
            <tr>
                <th>Name</th>
                <th>Data Source</th>
                <th>Updated</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var query in Model)
            {
                <tr>
                    <td>@query.Name</td>
                    <td>@query.DataSourceName</td>
                    <td>@query.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@query.Id">View</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@query.Id">Edit</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
