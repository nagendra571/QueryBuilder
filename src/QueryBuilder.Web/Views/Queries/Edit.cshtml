@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    ViewData["Title"] = "Edit Query";
}

<div class="query-page">
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_QueryForm" />
    </form>
</div>

<partial name="_QueryParametersModal" model="Model" />

<div class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 mb-0">Visualizations</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Visualizations" asp-action="Create" asp-route-queryId="@Model.Id">New Visualization</a>
    </div>
    <div class="alert alert-success d-none" id="visualizationDeleteAlert" role="alert"></div>
    @if (Model.Visualizations.Count == 0)
    {
        <div class="text-muted" data-viz-empty-message="true">No visualizations yet.</div>
    }
    else
    {
        <div class="list-group" data-visualization-list="true">
            @foreach (var viz in Model.Visualizations)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center" data-visualization-id="@viz.Id" data-visualization-name="@viz.Name">
                    <div>
                        <a class="fw-semibold text-decoration-none" asp-controller="Visualizations" asp-action="Details" asp-route-id="@viz.Id">@viz.Name</a>
                        <div class="small text-muted">@viz.Type</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Visualizations" asp-action="Edit" asp-route-id="@viz.Id">Edit</a>
                        @if (Model.CanDeleteVisualizations)
                        {
                            <button class="btn btn-sm btn-outline-danger js-delete-visualization"
                                    type="button"
                                    data-visualization-id="@viz.Id"
                                    data-visualization-name="@viz.Name">
                                Delete
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (Model.CanDeleteVisualizations)
{
    <div class="modal fade" id="deleteVisualizationModal" tabindex="-1" aria-labelledby="deleteVisualizationTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteVisualizationTitle">Delete visualization?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">This will remove the visualization from this query. This cannot be undone.</p>
                    <div class="alert alert-warning d-none" id="deleteVisualizationBlocked"></div>
                    <ul class="list-unstyled d-none" id="deleteVisualizationDashboards"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteVisualizationBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 mb-0">Sharing</h2>
        <button class="btn btn-sm btn-outline-secondary share-toggle" type="button" data-target="#sharePanel" aria-expanded="false">
            <i class="bi bi-people"></i>
            <span>Manage</span>
        </button>
    </div>
    <div id="sharePanel" class="share-panel d-none">
        <partial name="_ShareSection" model="Model.ShareSection" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/paged-results.js" asp-append-version="true"></script>
    <script>
        (() => {
            const toggle = document.querySelector('.share-toggle');
            const panel = document.querySelector('#sharePanel');
            if (!toggle || !panel) return;
            toggle.addEventListener('click', () => {
                const isHidden = panel.classList.toggle('d-none');
                toggle.setAttribute('aria-expanded', (!isHidden).toString());
            });
        })();
    </script>
    @if (Model.CanDeleteVisualizations)
    {
        <script>
            (() => {
                const deleteButtons = Array.from(document.querySelectorAll('.js-delete-visualization'));
                if (deleteButtons.length === 0) return;

                const modalEl = document.getElementById('deleteVisualizationModal');
                const confirmBtn = document.getElementById('confirmDeleteVisualizationBtn');
                const blockedAlert = document.getElementById('deleteVisualizationBlocked');
                const dashboardsList = document.getElementById('deleteVisualizationDashboards');
                const statusAlert = document.getElementById('visualizationDeleteAlert');
                const emptyMessages = Array.from(document.querySelectorAll('[data-viz-empty-message="true"]'));
                const listContainers = Array.from(document.querySelectorAll('[data-visualization-list="true"]'));
                const editVizBtn = document.querySelector('[data-edit-visualization-btn="true"]');
                const newVizBtn = document.querySelector('[data-new-visualization-btn="true"]');
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!modalEl || !confirmBtn || !blockedAlert || !dashboardsList || !token) return;

                const modal = window.bootstrap?.Modal ? new bootstrap.Modal(modalEl) : null;
                let activeVisualizationId = null;
                let activeVisualizationName = '';

                const setBlockedState = (message, dashboards) => {
                    blockedAlert.textContent = message;
                    blockedAlert.classList.remove('d-none');
                    dashboardsList.innerHTML = '';
                    if (dashboards.length > 0) {
                        dashboardsList.classList.remove('d-none');
                        dashboards.slice(0, 5).forEach(name => {
                            const item = document.createElement('li');
                            item.textContent = name;
                            dashboardsList.appendChild(item);
                        });
                        if (dashboards.length > 5) {
                            const more = document.createElement('li');
                            more.textContent = `and ${dashboards.length - 5} more`;
                            dashboardsList.appendChild(more);
                        }
                    } else {
                        dashboardsList.classList.add('d-none');
                    }
                    confirmBtn.disabled = true;
                };

                const resetModal = () => {
                    blockedAlert.classList.add('d-none');
                    blockedAlert.textContent = '';
                    dashboardsList.classList.add('d-none');
                    dashboardsList.innerHTML = '';
                    confirmBtn.disabled = false;
                };

                deleteButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        activeVisualizationId = btn.dataset.visualizationId;
                        activeVisualizationName = btn.dataset.visualizationName || 'Visualization';
                        resetModal();
                        modal?.show();
                    });
                });

                confirmBtn.addEventListener('click', async () => {
                    if (!activeVisualizationId) return;
                    confirmBtn.disabled = true;
                    try {
                        const response = await fetch(`/visualizations/${encodeURIComponent(activeVisualizationId)}/delete`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token.value
                            }
                        });
                        if (!response.ok) {
                            setBlockedState('Unable to delete visualization.', []);
                            return;
                        }
                        const payload = await response.json();
                        if (!payload.success) {
                            const dashboards = Array.isArray(payload.affectedDashboards) ? payload.affectedDashboards : [];
                            const message = payload.message || 'Cannot delete visualization.';
                            setBlockedState(message, dashboards);
                            return;
                        }

                        document.querySelectorAll(`[data-visualization-id="${activeVisualizationId}"]`).forEach(el => el.remove());
                        if (document.querySelectorAll('[data-visualization-id]').length === 0) {
                            listContainers.forEach(container => container.classList.add('d-none'));
                            emptyMessages.forEach(message => message.classList.remove('d-none'));
                            if (editVizBtn && newVizBtn) {
                                editVizBtn.classList.remove('d-none');
                                newVizBtn.classList.remove('btn-primary');
                                newVizBtn.classList.add('btn-outline-primary');
                            }
                        }

                        if (statusAlert) {
                            statusAlert.textContent = `${activeVisualizationName} deleted.`;
                            statusAlert.classList.remove('d-none');
                        }
                        modal?.hide();
                    } catch (err) {
                        setBlockedState('Unable to delete visualization.', []);
                    } finally {
                        confirmBtn.disabled = false;
                    }
                });
            })();
        </script>
    }
}
