@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    ViewData["Title"] = "Edit Query";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Edit Query</h1>
    <span class="badge text-bg-secondary">ID @Model.Id</span>
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_QueryForm" />
</form>

<div class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 mb-0">Visualizations</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Visualizations" asp-action="Create" asp-route-queryId="@Model.Id">New Visualization</a>
    </div>
    @if (Model.Visualizations.Count == 0)
    {
        <div class="text-muted">No visualizations yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var viz in Model.Visualizations)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   asp-controller="Visualizations"
                   asp-action="Details"
                   asp-route-id="@viz.Id">
                    <span>@viz.Name</span>
                    <span class="badge text-bg-secondary">@viz.Type</span>
                </a>
            }
        </div>
    }
</div>

<div class="mt-4">
    <partial name="_ShareSection" model="Model.ShareSection" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
