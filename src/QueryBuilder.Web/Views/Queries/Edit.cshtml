@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    ViewData["Title"] = "Edit Query";
}

<div class="query-page">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_QueryForm" />
    </form>
</div>

<partial name="_QueryParametersModal" model="Model" />

<div class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 mb-0">Visualizations</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Visualizations" asp-action="Create" asp-route-queryId="@Model.Id">New Visualization</a>
    </div>
    @if (Model.Visualizations.Count == 0)
    {
        <div class="text-muted">No visualizations yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var viz in Model.Visualizations)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <a class="fw-semibold text-decoration-none" asp-controller="Visualizations" asp-action="Details" asp-route-id="@viz.Id">@viz.Name</a>
                        <div class="small text-muted">@viz.Type</div>
                    </div>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Visualizations" asp-action="Edit" asp-route-id="@viz.Id">Edit</a>
                </div>
            }
        </div>
    }
</div>

<div class="mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h5 mb-0">Sharing</h2>
        <button class="btn btn-sm btn-outline-secondary share-toggle" type="button" data-target="#sharePanel" aria-expanded="false">
            <i class="bi bi-people"></i>
            <span>Manage</span>
        </button>
    </div>
    <div id="sharePanel" class="share-panel d-none">
        <partial name="_ShareSection" model="Model.ShareSection" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const toggle = document.querySelector('.share-toggle');
            const panel = document.querySelector('#sharePanel');
            if (!toggle || !panel) return;
            toggle.addEventListener('click', () => {
                const isHidden = panel.classList.toggle('d-none');
                toggle.setAttribute('aria-expanded', (!isHidden).toString());
            });
        })();
    </script>
}
