@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    var statusText = Model.Id.HasValue ? "Saved" : "Draft";
}

<div class="query-header">
    <div class="query-title">
        <div class="query-section-label">Query details</div>
        <input asp-for="Name" class="form-control form-control-lg query-title-input" placeholder="Untitled query" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <input asp-for="Description" class="form-control query-description-input" placeholder="Add a description" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="query-toolbar">
        <span class="badge text-bg-light border query-status">@statusText</span>
        <div class="btn-group">
            <button class="btn btn-primary" type="submit" name="SubmitAction" value="run">Run Query</button>
            <button class="btn btn-outline-secondary" type="submit" name="SubmitAction" value="save">Save</button>
        </div>
        <div class="form-check form-switch query-toggle">
            <input class="form-check-input" type="checkbox" id="showDataOnlyToggle" />
            <label class="form-check-label" for="showDataOnlyToggle">Show data only</label>
        </div>
        <a class="btn btn-link query-back" asp-action="Index">Back</a>
    </div>
</div>
<input type="hidden" name="SubmitAction" id="submitActionHidden" />

<div class="query-editor-body" id="queryEditorBody">
    <div class="query-layout">
        <div class="query-schema-panel">
            <div class="query-section-label">Schema browser</div>
            <div class="mb-3">
                <label asp-for="DataSourceId" class="form-label"></label>
                <select asp-for="DataSourceId" class="form-select" asp-items="ViewBag.DataSources" id="dataSourceSelect"></select>
                <span asp-validation-for="DataSourceId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" for="schemaSearch">Schema</label>
                <input class="form-control" id="schemaSearch" placeholder="Search tables..." />
            </div>
            <div class="query-schema-list list-group" id="schemaList">
                <div class="list-group-item text-muted">Select a data source to load tables.</div>
            </div>
        </div>

        <div class="query-editor-panel">
            <div class="query-section-label">SQL editor</div>
            <div class="mb-3">
                <label asp-for="SqlText" class="form-label"></label>
                <div class="sql-editor">
                    <pre class="sql-gutter" id="sqlLineNumbers">1</pre>
                    <textarea asp-for="SqlText" class="form-control font-monospace sql-editor-input" rows="11" placeholder="Write your SQL here..."></textarea>
                </div>
                <span asp-validation-for="SqlText" class="text-danger"></span>
                <div class="form-text">MVP supports SELECT queries only.</div>
            </div>
            @if (Model.Id.HasValue)
            {
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="query-section-label mb-0">Parameters</div>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#addParameterModal">
                        + Add Parameter
                    </button>
                </div>
                <partial name="_QueryParametersBar" model="Model" />
            }
            else
            {
                <div class="alert alert-light border mt-3">
                    Save the query to configure parameters.
                </div>
            }
        </div>
    </div>
</div>

<script>
    (() => {
        const strip = document.querySelector("[data-params-strip='true']");
        if (!strip) return;

        const grid = strip.querySelector("[data-params-grid='true']");
        const emptyMessage = strip.querySelector("[data-params-empty='true']");
        const missingAlert = strip.querySelector("[data-params-missing='true']");
        const applyBtn = document.getElementById("applyParamsBtn");
        const resetBtn = document.getElementById("resetParamsBtn");
        const actions = strip.querySelector("[data-params-actions='true']");
        const submitAction = document.getElementById("submitActionHidden");
        const form = strip.closest("form");
        if (!applyBtn || !resetBtn || !actions || !submitAction || !form) return;

        const initial = new Map();
        const getInputs = () => Array.from(strip.querySelectorAll("[data-param-input='true']"));
        const bindInput = (input) => {
            if (input.dataset.paramBound === "true") return;
            if (!initial.has(input.name)) {
                initial.set(input.name, input.value);
            }
            input.addEventListener("input", updateState);
            input.addEventListener("change", updateState);
            input.dataset.paramBound = "true";
        };

        const refreshInputs = () => {
            getInputs().forEach(bindInput);
            updateState();
        };

        const updateState = () => {
            const dirty = getInputs().some(input => input.value !== (initial.get(input.name) ?? ""));
            actions.classList.toggle("is-visible", dirty);
        };

        const pad = (value) => String(value).padStart(2, "0");
        const formatDate = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
        const formatDateTime = (date) =>
            `${formatDate(date)}T${pad(date.getHours())}:${pad(date.getMinutes())}`;

        const startOfMonth = (date) => new Date(date.getFullYear(), date.getMonth(), 1);
        const endOfMonth = (date) => new Date(date.getFullYear(), date.getMonth() + 1, 0);
        const startOfYear = (date) => new Date(date.getFullYear(), 0, 1);
        const endOfYear = (date) => new Date(date.getFullYear(), 11, 31);

        const resolvePresetRange = (preset) => {
            const now = new Date();
            let start = null;
            let end = null;
            switch (preset) {
                case "last_7_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 7);
                    break;
                case "last_14_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 14);
                    break;
                case "last_30_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 30);
                    break;
                case "last_60_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 60);
                    break;
                case "last_90_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 90);
                    break;
                case "this_month":
                    start = startOfMonth(now);
                    end = endOfMonth(now);
                    break;
                case "last_month":
                    const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    start = startOfMonth(lastMonth);
                    end = endOfMonth(lastMonth);
                    break;
                case "this_year":
                    start = startOfYear(now);
                    end = endOfYear(now);
                    break;
                case "last_year":
                    const lastYear = new Date(now.getFullYear() - 1, 0, 1);
                    start = startOfYear(lastYear);
                    end = endOfYear(lastYear);
                    break;
            }
            return { start, end };
        };

        const applySinglePreset = (input, preset, isDateTime) => {
            const now = new Date();
            let value = null;
            switch (preset) {
                case "now":
                    value = now;
                    break;
                case "today":
                    value = now;
                    break;
                case "yesterday":
                    value = new Date(now);
                    value.setDate(value.getDate() - 1);
                    break;
                case "last_7_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 7);
                    break;
                case "last_14_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 14);
                    break;
                case "last_30_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 30);
                    break;
                case "last_60_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 60);
                    break;
                case "last_90_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 90);
                    break;
                case "this_month":
                    value = startOfMonth(now);
                    break;
                case "last_month":
                    value = startOfMonth(new Date(now.getFullYear(), now.getMonth() - 1, 1));
                    break;
                case "this_year":
                    value = startOfYear(now);
                    break;
                case "last_year":
                    value = startOfYear(new Date(now.getFullYear() - 1, 0, 1));
                    break;
                default:
                    return;
            }
            input.value = isDateTime ? formatDateTime(value) : formatDate(value);
            updateState();
        };

        const applyRangePreset = (startInput, endInput, preset, isDateTime) => {
            const { start, end } = resolvePresetRange(preset);
            if (!start || !end) return;
            const formatter = isDateTime ? formatDateTime : formatDate;
            startInput.value = formatter(start);
            endInput.value = formatter(end);
            updateState();
        };

        resetBtn.addEventListener("click", () => {
            getInputs().forEach(input => {
                input.value = initial.get(input.name) ?? "";
            });
            updateState();
        });

        applyBtn.addEventListener("click", () => {
            submitAction.value = "run";
            form.requestSubmit();
        });

        strip.addEventListener("click", (event) => {
            const button = event.target.closest(".query-param-presets [data-preset]");
            if (!button) return;
            const preset = button.getAttribute("data-preset");
            if (!preset) return;

            const dateGroup = button.closest("[data-param-date-group='true']");
            if (dateGroup) {
                const input = dateGroup.querySelector("[data-param-date='true']");
                if (!input) return;
                const isDateTime = input.dataset.paramKind === "datetime";
                applySinglePreset(input, preset, isDateTime);
                return;
            }

            const rangeGroup = button.closest("[data-param-range-group='true']");
            if (rangeGroup) {
                const startInput = rangeGroup.querySelector("[data-param-range='start']");
                const endInput = rangeGroup.querySelector("[data-param-range='end']");
                if (!startInput || !endInput) return;
                const isDateTime = rangeGroup.dataset.paramKind === "datetime";
                applyRangePreset(startInput, endInput, preset, isDateTime);
            }
        });

        const normalize = (value) => value.trim().toLowerCase();

        const parseTokens = (sql) => {
            const tokens = new Map();
            const regex = /{{\s*([\w.]+)\s*}}/g;
            let match;
            while ((match = regex.exec(sql)) !== null) {
                const raw = match[1];
                const parts = raw.split(".");
                const name = normalize(parts[0]);
                const suffix = parts.length > 1 ? parts[1].toLowerCase() : null;
                const info = tokens.get(name) || { name: parts[0], hasRange: false };
                if (suffix === "start" || suffix === "end") {
                    info.hasRange = true;
                }
                tokens.set(name, info);
            }
            return tokens;
        };

        const getExistingNames = () => {
            const names = new Set();
            grid?.querySelectorAll(".query-param-card").forEach((card) => {
                const name = card.dataset.paramName;
                if (name) {
                    names.add(normalize(name));
                }
            });
            return names;
        };

        const createClientCard = (info) => {
            const card = document.createElement("div");
            card.className = "query-param-card";
            card.dataset.paramName = info.name;
            card.dataset.paramTitle = info.name;
            card.dataset.paramType = info.hasRange ? "DateRange" : "Text";
            card.dataset.paramDefault = "";
            card.dataset.paramSettings = "{}";
            card.dataset.paramRequired = "false";
            card.dataset.paramClient = "true";

            const label = document.createElement("div");
            label.className = "query-param-label";
            label.innerHTML = `<span>${info.name}</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="query-param-unsaved">Unsaved</span>
                    <button class="btn btn-link p-0 query-param-gear" type="button" title="Edit parameter">
                        <i class="bi bi-gear"></i>
                    </button>
                </div>`;
            card.appendChild(label);

            if (info.hasRange) {
                const wrap = document.createElement("div");
                wrap.className = "query-param-range-group";
                wrap.setAttribute("data-param-range-group", "true");
                wrap.setAttribute("data-param-kind", "date");
                wrap.innerHTML = `
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" type="date" data-param-input="true" data-param-range="start" name="ParameterValues[${info.name}.start]" />
                        <input class="form-control form-control-sm" type="date" data-param-input="true" data-param-range="end" name="ParameterValues[${info.name}.end]" />
                    </div>
                `;
                card.appendChild(wrap);
            } else {
                const input = document.createElement("input");
                input.className = "form-control form-control-sm";
                input.setAttribute("data-param-input", "true");
                input.name = `ParameterValues[${info.name}]`;
                input.placeholder = "Enter value";
                card.appendChild(input);
            }

            return card;
        };

        const updateClientCards = (sql) => {
            if (!grid) return;
            const tokens = parseTokens(sql);
            const existing = getExistingNames();

            grid.querySelectorAll("[data-param-client='true']").forEach((card) => {
                const name = normalize(card.dataset.paramName || "");
                if (!tokens.has(name)) {
                    card.remove();
                }
            });

            tokens.forEach((info, key) => {
                if (!existing.has(key)) {
                    const card = createClientCard(info);
                    grid.appendChild(card);
                }
            });

            refreshInputs();
            if (emptyMessage) {
                const hasAny = grid.querySelectorAll(".query-param-card").length > 0;
                emptyMessage.classList.toggle("d-none", hasAny);
            }
            if (missingAlert) {
                const hasClient = grid.querySelectorAll("[data-param-client='true']").length > 0;
                missingAlert.classList.toggle("d-none", hasClient);
            }
        };

        const getSqlText = () => {
            if (window.queryBuilderEditor) {
                return window.queryBuilderEditor.state.doc.toString();
            }
            const sqlInput = document.getElementById("SqlText");
            return sqlInput?.value || "";
        };

        const attachSqlListener = () => {
            if (window.queryBuilderEditor && !window.queryBuilderEditor.dom.dataset.paramTokenListener) {
                window.queryBuilderEditor.dom.dataset.paramTokenListener = "true";
                window.queryBuilderEditor.dom.addEventListener("keyup", () => updateClientCards(getSqlText()));
                window.queryBuilderEditor.dom.addEventListener("input", () => updateClientCards(getSqlText()));
                return true;
            }

            const sqlInput = document.getElementById("SqlText");
            if (sqlInput && !sqlInput.dataset.paramTokenListener) {
                sqlInput.dataset.paramTokenListener = "true";
                sqlInput.addEventListener("input", () => updateClientCards(getSqlText()));
                return true;
            }
            return false;
        };

        refreshInputs();
        let lastSql = getSqlText();
        updateClientCards(lastSql);
        if (!attachSqlListener()) {
            const timer = setInterval(() => {
                if (attachSqlListener()) {
                    clearInterval(timer);
                }
            }, 400);
        }

        setInterval(() => {
            const currentSql = getSqlText();
            if (currentSql !== lastSql) {
                lastSql = currentSql;
                updateClientCards(currentSql);
            }
        }, 500);

        window.queryBuilderParamStrip = {
            refreshInputs
        };
    })();
</script>

@if (Model.Result != null)
{
    if (Model.Result.Success)
    {
        <div class="alert alert-success">
            Query executed in @Model.Result.DurationMs ms. Rows returned: @Model.Result.RowCount.
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            @Model.Result.ErrorMessage
        </div>
    }

    if (Model.Result.Success)
    {
        <div class="results-card card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <ul class="nav nav-tabs card-header-tabs" id="resultsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-table" data-bs-toggle="tab" data-bs-target="#tabTablePane" type="button" role="tab">Table</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-viz" data-bs-toggle="tab" data-bs-target="#tabVizPane" type="button" role="tab">Visualizations</button>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="downloadCsvBtn">Download CSV</button>
                    @if (Model.Id.HasValue)
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Visualizations" asp-action="Create" asp-route-queryId="@Model.Id">+ New Visualization</a>
                    }
                </div>
            </div>
            <div class="card-body tab-content">
                <div class="tab-pane fade show active" id="tabTablePane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                            <tr>
                                @foreach (var column in Model.Result.Columns)
                                {
                                    <th>@column</th>
                                }
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Result.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="@Model.Result.Columns.Count" class="text-muted">No rows returned.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var row in Model.Result.Rows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td>@cell</td>
                                        }
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="tabVizPane" role="tabpanel">
                    @if (Model.Visualizations.Count == 0)
                    {
                        <div class="text-muted">No visualizations yet. Create one to see it here.</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var viz in Model.Visualizations)
                            {
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                   asp-controller="Visualizations"
                                   asp-action="Details"
                                   asp-route-id="@viz.Id">
                                    <span>@viz.Name</span>
                                    <span class="badge text-bg-secondary">@viz.Type</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<script>
    (() => {
        const toggle = document.getElementById('showDataOnlyToggle');
        const editor = document.getElementById('queryEditorBody');
        if (!toggle || !editor) return;
        toggle.addEventListener('change', () => {
            editor.classList.toggle('d-none', toggle.checked);
        });
    })();
</script>

<script>
    (() => {
        const dataSourceSelect = document.getElementById('dataSourceSelect');
        const schemaList = document.getElementById('schemaList');
        const schemaSearch = document.getElementById('schemaSearch');
        const sqlEditor = document.getElementById('SqlText');
        if (!dataSourceSelect || !schemaList || !schemaSearch) return;

        let tables = [];
        const schemaState = window.queryBuilderSchema = window.queryBuilderSchema || { tables: [], columnsByTable: {} };

        const insertText = (text) => {
            const cm = window.queryBuilderEditor;
            if (cm) {
                const range = cm.state.selection.main;
                cm.dispatch({
                    changes: { from: range.from, to: range.to, insert: text }
                });
                cm.focus();
                return;
            }

            if (!sqlEditor) return;
            const start = sqlEditor.selectionStart ?? sqlEditor.value.length;
            const end = sqlEditor.selectionEnd ?? sqlEditor.value.length;
            const value = sqlEditor.value;
            sqlEditor.value = value.slice(0, start) + text + value.slice(end);
            sqlEditor.focus();
            sqlEditor.selectionStart = sqlEditor.selectionEnd = start + text.length;
        };

        const renderList = (items) => {
            schemaList.innerHTML = '';
            if (items.length === 0) {
                schemaList.innerHTML = '<div class="list-group-item text-muted">No tables found.</div>';
                return;
            }

            items.forEach((item) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'schema-table';

                const header = document.createElement('button');
                header.type = 'button';
                header.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2';
                header.innerHTML = `<span class="schema-caret">&gt;</span><span class="schema-name">${item.schema}.${item.name}</span>`;
                header.addEventListener('click', async () => {
                    const isExpanded = wrapper.classList.toggle('expanded');
                    const caret = header.querySelector('.schema-caret');
                    if (caret) caret.textContent = isExpanded ? 'v' : '>';

                    if (isExpanded && !wrapper.dataset.loaded) {
                        wrapper.dataset.loaded = '1';
                        const columnsContainer = wrapper.querySelector('.schema-columns');
                        if (columnsContainer) {
                            columnsContainer.innerHTML = '<div class="text-muted small px-3 py-2">Loading columns...</div>';
                        }
                        await loadColumns(item, wrapper);
                    }
                });

                const columns = document.createElement('div');
                columns.className = 'schema-columns';
                wrapper.appendChild(header);
                wrapper.appendChild(columns);
                wrapper.dataset.schema = item.schema;
                wrapper.dataset.table = item.name;
                schemaList.appendChild(wrapper);
            });
        };

        const applyFilter = () => {
            const term = schemaSearch.value.trim().toLowerCase();
            const filtered = term
                ? tables.filter(t => `${t.schema}.${t.name}`.toLowerCase().includes(term))
                : tables;
            renderList(filtered);
        };

        const loadColumns = async (table, wrapper) => {
            const dataSourceId = Number(dataSourceSelect.value);
            if (!dataSourceId) return;

            try {
                const url = `/Queries/SchemaColumns?dataSourceId=${dataSourceId}&schemaName=${encodeURIComponent(table.schema)}&tableName=${encodeURIComponent(table.name)}`;
                const response = await fetch(url);
                const data = await response.json();
                const container = wrapper.querySelector('.schema-columns');
                if (!container) return;

                if (!response.ok || !data.success) {
                    container.innerHTML = `<div class="text-danger small px-3 py-2">${data.errorMessage || 'Failed to load columns.'}</div>`;
                    return;
                }

                if (!data.columns || data.columns.length === 0) {
                    container.innerHTML = '<div class="text-muted small px-3 py-2">No columns found.</div>';
                    return;
                }

                const tableKey = `${table.schema}.${table.name}`;
                schemaState.columnsByTable[tableKey] = data.columns;

                container.innerHTML = '';
                data.columns.forEach((col) => {
                    const row = document.createElement('button');
                    row.type = 'button';
                    row.className = 'schema-column';
                    row.innerHTML = `<span class="schema-column-name">${col.name}</span><span class="schema-column-type">${col.dataType}</span>`;
                    row.addEventListener('click', (event) => {
                        event.stopPropagation();
                        insertText(`[${col.name}]`);
                    });
                    container.appendChild(row);
                });
            } catch (err) {
                const container = wrapper.querySelector('.schema-columns');
                if (container) {
                    container.innerHTML = '<div class="text-danger small px-3 py-2">Failed to load columns.</div>';
                }
            }
        };

        const loadSchema = async () => {
            const dataSourceId = Number(dataSourceSelect.value);
            schemaList.innerHTML = '<div class="list-group-item text-muted">Loading tables...</div>';
            if (!dataSourceId) {
                schemaList.innerHTML = '<div class="list-group-item text-muted">Select a data source to load tables.</div>';
                tables = [];
                schemaState.tables = [];
                schemaState.columnsByTable = {};
                return;
            }

            try {
                const response = await fetch(`/Queries/Schema?dataSourceId=${dataSourceId}`);
                const data = await response.json();
                if (!response.ok || !data.success) {
                    schemaList.innerHTML = `<div class="list-group-item text-danger">${data.errorMessage || 'Failed to load schema.'}</div>`;
                    tables = [];
                    schemaState.tables = [];
                    schemaState.columnsByTable = {};
                    return;
                }
                tables = data.tables || [];
                schemaState.tables = tables;
                schemaState.columnsByTable = {};
                applyFilter();
            } catch (err) {
                schemaList.innerHTML = '<div class="list-group-item text-danger">Failed to load schema.</div>';
                tables = [];
                schemaState.tables = [];
                schemaState.columnsByTable = {};
            }
        };

        dataSourceSelect.addEventListener('change', loadSchema);
        schemaSearch.addEventListener('input', applyFilter);

        loadSchema();
    })();
</script>

<script>
    (() => {
        const input = document.querySelector('.sql-editor-input');
        const gutter = document.getElementById('sqlLineNumbers');
        if (!input || !gutter) return;

        const updateLineNumbers = () => {
            const lines = input.value.split('\n').length || 1;
            gutter.textContent = Array.from({ length: lines }, (_, i) => i + 1).join('\n');
        };

        input.addEventListener('input', updateLineNumbers);
        input.addEventListener('scroll', () => {
            gutter.scrollTop = input.scrollTop;
        });

        updateLineNumbers();
    })();
</script>

<script>
    (() => {
        const form = document.querySelector('form');
        const submitAction = document.getElementById('submitActionHidden');
        if (!form || !submitAction) return;
        document.addEventListener('keydown', (event) => {
            const isCmd = event.metaKey && !event.ctrlKey;
            const isCtrl = event.ctrlKey && !event.metaKey;
            if ((isCmd || isCtrl) && event.key === 'Enter') {
                event.preventDefault();
                submitAction.value = 'run';
                form.requestSubmit();
            }
        });
    })();
</script>

@if (Model.Result != null && Model.Result.Success)
{
    @using System.Text.Json
    var columnsJson = JsonSerializer.Serialize(Model.Result.Columns);
    var rowsJson = JsonSerializer.Serialize(Model.Result.Rows);

    <script>
        (() => {
            const btn = document.getElementById('downloadCsvBtn');
            if (!btn) return;

            const columns = @Html.Raw(columnsJson);
            const rows = @Html.Raw(rowsJson);

            const escapeCell = (value) => {
                if (value === null || value === undefined) return '';
                const str = String(value);
                if (str.includes('"') || str.includes(',') || str.includes('\n')) {
                    return `"${str.replace(/"/g, '""')}"`;
                }
                return str;
            };

            btn.addEventListener('click', () => {
                const lines = [];
                lines.push(columns.map(escapeCell).join(','));
                rows.forEach(row => {
                    lines.push(row.map(escapeCell).join(','));
                });
                const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = 'query-results.csv';
                link.click();
                URL.revokeObjectURL(url);
            });
        })();
    </script>
}

<script type="module">
    import { EditorState } from "https://esm.sh/@@codemirror/state";
    import { EditorView, keymap, lineNumbers, highlightActiveLineGutter, drawSelection } from "https://esm.sh/@@codemirror/view";
    import { defaultKeymap, history, historyKeymap } from "https://esm.sh/@@codemirror/commands";
    import { autocompletion } from "https://esm.sh/@@codemirror/autocomplete";
    import { sql, MSSQL } from "https://esm.sh/@@codemirror/lang-sql";
    import { oneDark } from "https://esm.sh/@@codemirror/theme-one-dark";

    const textarea = document.querySelector(".sql-editor-input");
    if (textarea) {
        const host = document.createElement("div");
        host.className = "cm-host";
        textarea.parentElement?.appendChild(host);

        const schemaCompletion = (context) => {
            const word = context.matchBefore(/[\w.\]]+/);
            if (!word && !context.explicit) return null;
            const from = word ? word.from : context.pos;
            const term = word ? word.text.replace(/\[/g, '').toLowerCase() : '';
            const schema = window.queryBuilderSchema || { tables: [], columnsByTable: {} };

            const options = [];
            schema.tables.forEach((table) => {
                const label = `[${table.schema}].[${table.name}]`;
                if (!term || label.toLowerCase().includes(term)) {
                    options.push({ label, type: "table" });
                }
            });

            Object.entries(schema.columnsByTable || {}).forEach(([tableKey, cols]) => {
                cols.forEach((col) => {
                    const label = `[${col.name}]`;
                    if (!term || label.toLowerCase().includes(term)) {
                        options.push({ label, type: "property", detail: tableKey });
                    }
                });
            });

            return { from, options, validFor: /[\w.\]]*/ };
        };

        const state = EditorState.create({
            doc: textarea.value,
            extensions: [
                lineNumbers(),
                highlightActiveLineGutter(),
                history(),
                drawSelection(),
                keymap.of([...defaultKeymap, ...historyKeymap]),
                sql({ dialect: MSSQL }),
                autocompletion({ override: [schemaCompletion] }),
                oneDark
            ]
        });

        const view = new EditorView({
            state,
            parent: host
        });

        textarea.style.display = "none";
        document.body.classList.add("editor-enhanced");
        window.queryBuilderEditor = view;

        const form = textarea.closest("form");
        form?.addEventListener("submit", () => {
            textarea.value = view.state.doc.toString();
        });
    }
</script>
