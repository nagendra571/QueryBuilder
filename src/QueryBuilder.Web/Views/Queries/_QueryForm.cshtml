@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    var statusText = Model.Id.HasValue ? "Saved" : "Draft";
}

<div class="query-header">
    <div class="query-title">
        <div class="query-section-label">Query details</div>
        <input asp-for="Name" class="form-control input-compact query-title-input" placeholder="Untitled query" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <input asp-for="Description" class="form-control input-compact query-description-input" placeholder="Add a description" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="query-toolbar">
        <span class="badge text-bg-light border query-status">@statusText</span>
        <div class="btn-group">
            <button class="btn btn-primary btn-compact" type="submit" name="SubmitAction" value="run">Run Query</button>
            <button class="btn btn-outline-secondary btn-compact" type="submit" name="SubmitAction" value="save">Save</button>
        </div>
        <div class="form-check form-switch query-toggle">
            <input class="form-check-input" type="checkbox" id="showDataOnlyToggle" />
            <label class="form-check-label" for="showDataOnlyToggle">Show data only</label>
        </div>
        <a class="btn btn-link query-back" asp-action="Index">Back</a>
    </div>
</div>
<input type="hidden" name="SubmitAction" id="submitActionHidden" />
<button type="submit" name="SubmitAction" value="run" id="runQuerySubmit" class="d-none" tabindex="-1"></button>
<button type="submit" name="SubmitAction" value="save" id="saveQuerySubmit" class="d-none" tabindex="-1"></button>

<div class="query-editor-body" id="queryEditorBody">
    <div class="query-layout" data-split-layout="true">
        <div class="query-schema-panel" data-split-left="true">
            <div class="query-section-label">Schema browser</div>
            <div class="mb-3">
                <label asp-for="DataSourceId" class="form-label"></label>
                <select asp-for="DataSourceId" class="form-select input-compact" asp-items="ViewBag.DataSources" id="dataSourceSelect"></select>
                <span asp-validation-for="DataSourceId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" for="schemaSearch">Schema</label>
                <input class="form-control input-compact" id="schemaSearch" placeholder="Search tables..." />
            </div>
            <div class="query-schema-list list-group" id="schemaList">
                <div class="list-group-item text-muted">Select a data source to load tables.</div>
            </div>
        </div>

        <div class="splitter-vertical" id="splitterVertical" aria-hidden="true"></div>

        <div class="query-editor-panel" data-split-right="true">
                <div class="query-section-label">SQL editor</div>
                <div class="mb-3">
                    <label asp-for="SqlText" class="form-label"></label>
                    <div class="sql-editor">
                        <pre class="sql-gutter" id="sqlLineNumbers">1</pre>
                        <textarea asp-for="SqlText" class="form-control font-monospace sql-editor-input" rows="11" placeholder="Write your SQL here..."></textarea>
                    </div>
                    <span asp-validation-for="SqlText" class="text-danger"></span>
                    <div class="form-text">MVP supports SELECT queries only.</div>
                </div>
                <div class="sql-editor-actions">
                    <div class="sql-editor-actions-left">
                        @if (Model.Id.HasValue)
                        {
                            <button class="btn btn-sm btn-light btn-compact"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addParameterModal"
                                    data-bs-toggle="tooltip"
                                    data-bs-title="Add parameter">
                                {{ }}
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-light btn-compact"
                                    type="button"
                                    disabled
                                    data-bs-toggle="tooltip"
                                    data-bs-title="Save the query to add parameters.">
                                {{ }}
                            </button>
                        }
                        <button class="btn btn-sm btn-light btn-compact"
                                type="button"
                                id="formatSqlBtn"
                                data-bs-toggle="tooltip"
                                data-bs-title="Format SQL">
                            <i class="bi bi-code-slash"></i>
                        </button>
                        <button class="btn btn-sm btn-light btn-compact"
                                type="button"
                                id="toggleAutocompleteBtn"
                                data-bs-toggle="tooltip"
                                data-bs-title="Toggle autocomplete">
                            <i class="bi bi-lightning"></i>
                        </button>
                    </div>
                <div class="sql-editor-actions-right">
                    <button class="btn btn-sm btn-primary btn-compact" type="button" id="runQueryInlineBtn">Run Query</button>
                    <button class="btn btn-sm btn-outline-secondary btn-compact" type="button" id="saveQueryInlineBtn">Save</button>
                </div>
            </div>
            <div class="sql-editor-meta">
                <button class="btn btn-link btn-sm p-0" type="button" id="resetLayoutBtn">Reset layout</button>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="query-section-label mb-0">Parameters</div>
                    @if (Model.Id.HasValue)
                    {
                        <button class="btn btn-sm btn-outline-primary btn-compact" type="button" data-bs-toggle="modal" data-bs-target="#addParameterModal">
                            + Add Parameter
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-primary btn-compact" type="button" disabled title="Save the query to configure parameter settings.">
                            + Add Parameter
                        </button>
                    }
                </div>
                <partial name="_QueryParametersBar" model="Model" />
                @if (!Model.Id.HasValue)
                {
                    <div class="form-text text-muted mt-2">
                        Type {{param}} in SQL to add parameters. Save the query to configure parameter settings.
                    </div>
                }
            @if (Model.Result != null)
            {
                if (Model.Result.Success)
                {
                    <div class="alert alert-success">
                        Query executed in @Model.Result.DurationMs ms. Rows returned: @Model.Result.RowCount.
                    </div>
                }
                else
                {
                    if (Model.Result.ParameterErrors.Count > 0)
                    {
                        <div class="alert alert-danger" data-param-validation-errors="true">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in Model.Result.ParameterErrors)
                                {
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(error.Parameter))
                                        {
                                            <span>Parameter <strong>@error.Parameter</strong> @error.Message</span>
                                        }
                                        else
                                        {
                                            <span>@error.Message</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">@Model.Result.ErrorMessage</div>
                    }
                }

                if (Model.Result.Success)
                {
                    <div class="results-card card">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <ul class="nav nav-tabs card-header-tabs" id="resultsTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="tab-table" data-bs-toggle="tab" data-bs-target="#tabTablePane" type="button" role="tab">Table</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="tab-viz" data-bs-toggle="tab" data-bs-target="#tabVizPane" type="button" role="tab">Visualizations</button>
                                </li>
                            </ul>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary btn-compact" type="button" id="downloadCsvBtn">Download CSV</button>
                                @if (Model.Id.HasValue && Model.Result.Success)
                                {
                                    <a class="btn btn-sm btn-primary btn-compact @(Model.ShowEditVisualization ? "" : "d-none")"
                                       data-edit-visualization-btn="true"
                                       asp-controller="Visualizations"
                                       asp-action="Create"
                                       asp-route-queryId="@Model.Id"
                                       asp-route-executionId="@Model.Result?.ExecutionId">Edit Visualization</a>
                                    <a class="btn btn-sm btn-compact @(Model.ShowEditVisualization ? "btn-outline-primary" : "btn-primary")"
                                       data-new-visualization-btn="true"
                                       asp-controller="Visualizations"
                                       asp-action="Create"
                                       asp-route-queryId="@Model.Id"
                                       asp-route-executionId="@Model.Result?.ExecutionId">+ New Visualization</a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary btn-compact" type="button" disabled title="Run and save the query before creating a visualization.">
                                        + New Visualization
                                    </button>
                                }
                            </div>
                            @if (!Model.Id.HasValue || !Model.Result.Success)
                            {
                                <div class="form-text text-muted mt-2">
                                    Save and successfully run the query to create a visualization.
                                </div>
                            }
                        </div>
                        <div class="card-body tab-content">
                            <div class="tab-pane fade show active" id="tabTablePane" role="tabpanel">
                                <div class="query-results-pager"
                                     data-paged-table="true"
                                     data-query-id="@Model.Id"
                                     data-execution-id="@Model.Result?.ExecutionId"
                                     data-endpoint-template="/queries/{queryId}/executions/{executionId}/results"
                                     data-storage-key="queryEditor.pageSize">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-muted small" data-page-status>Page 1</div>
                                        <div class="d-flex align-items-center gap-2">
                                            <label class="form-label mb-0 small">Rows per page</label>
                                            <select class="form-select form-select-sm input-compact" data-page-size>
                                                <option value="25">25</option>
                                                <option value="50">50</option>
                                                <option value="100">100</option>
                                                <option value="250">250</option>
                                                <option value="500">500</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="text-muted" data-page-loading>Loading results...</div>
                                    <div data-page-table></div>
                                    <div class="d-flex justify-content-between align-items-center mt-2" data-page-controls>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary btn-compact" type="button" data-page-prev>Prev</button>
                                            <button class="btn btn-outline-secondary btn-compact" type="button" data-page-next>Next</button>
                                        </div>
                                        <div class="text-muted small" data-page-info></div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tabVizPane" role="tabpanel">
                                <div class="text-muted @(Model.Visualizations.Count == 0 ? "" : "d-none")" data-viz-empty-message="true">
                                    No visualizations yet. Create one to see it here.
                                </div>
                                <div class="list-group @(Model.Visualizations.Count == 0 ? "d-none" : "")" data-visualization-list="true">
                                    @foreach (var viz in Model.Visualizations)
                                    {
                                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                           data-visualization-id="@viz.Id"
                                           asp-controller="Visualizations"
                                           asp-action="Details"
                                           asp-route-id="@viz.Id">
                                            <span>@viz.Name</span>
                                            <span class="badge text-bg-secondary">@viz.Type</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    (() => {
        const strip = document.querySelector("[data-params-strip='true']");
        if (!strip) return;

        const grid = strip.querySelector("[data-params-grid='true']");
        const emptyMessage = strip.querySelector("[data-params-empty='true']");
        const missingAlert = strip.querySelector("[data-params-missing='true']");
        const applyBtn = document.getElementById("applyParamsBtn");
        const resetBtn = document.getElementById("resetParamsBtn");
        const actions = strip.querySelector("[data-params-actions='true']");
        const submitAction = document.getElementById("submitActionHidden");
        const form = strip.closest("form");
        if (!applyBtn || !resetBtn || !actions || !submitAction || !form) return;

        const initial = new Map();
        const getInputs = () => Array.from(strip.querySelectorAll("[data-param-input='true']"));
        const clearValidationErrors = () => {
            const alert = document.querySelector("[data-param-validation-errors='true']");
            if (alert) {
                alert.remove();
            }
            strip.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
            strip.querySelectorAll("[data-param-inline-error='true']").forEach((el) => el.remove());
        };

        const bindInput = (input) => {
            if (input.dataset.paramBound === "true") return;
            if (!initial.has(input.name)) {
                initial.set(input.name, input.value);
            }
            const onInput = () => {
                clearValidationErrors();
                updateState();
            };
            input.addEventListener("input", onInput);
            input.addEventListener("change", onInput);
            input.dataset.paramBound = "true";
        };

        const refreshInputs = () => {
            getInputs().forEach(bindInput);
            updateState();
        };

        const updateState = () => {
            const dirty = getInputs().some(input => input.value !== (initial.get(input.name) ?? ""));
            actions.classList.toggle("is-visible", dirty);
        };

        const pad = (value) => String(value).padStart(2, "0");
        const formatDate = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
        const formatDateTime = (date) =>
            `${formatDate(date)}T${pad(date.getHours())}:${pad(date.getMinutes())}`;

        const startOfMonth = (date) => new Date(date.getFullYear(), date.getMonth(), 1);
        const endOfMonth = (date) => new Date(date.getFullYear(), date.getMonth() + 1, 0);
        const startOfYear = (date) => new Date(date.getFullYear(), 0, 1);
        const endOfYear = (date) => new Date(date.getFullYear(), 11, 31);

        const resolvePresetRange = (preset) => {
            const now = new Date();
            let start = null;
            let end = null;
            switch (preset) {
                case "last_7_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 7);
                    break;
                case "last_14_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 14);
                    break;
                case "last_30_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 30);
                    break;
                case "last_60_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 60);
                    break;
                case "last_90_days":
                    end = now;
                    start = new Date(now);
                    start.setDate(start.getDate() - 90);
                    break;
                case "this_month":
                    start = startOfMonth(now);
                    end = endOfMonth(now);
                    break;
                case "last_month":
                    const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    start = startOfMonth(lastMonth);
                    end = endOfMonth(lastMonth);
                    break;
                case "this_year":
                    start = startOfYear(now);
                    end = endOfYear(now);
                    break;
                case "last_year":
                    const lastYear = new Date(now.getFullYear() - 1, 0, 1);
                    start = startOfYear(lastYear);
                    end = endOfYear(lastYear);
                    break;
            }
            return { start, end };
        };

        const applySinglePreset = (input, preset, isDateTime) => {
            const now = new Date();
            let value = null;
            switch (preset) {
                case "now":
                    value = now;
                    break;
                case "today":
                    value = now;
                    break;
                case "yesterday":
                    value = new Date(now);
                    value.setDate(value.getDate() - 1);
                    break;
                case "last_7_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 7);
                    break;
                case "last_14_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 14);
                    break;
                case "last_30_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 30);
                    break;
                case "last_60_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 60);
                    break;
                case "last_90_days":
                    value = new Date(now);
                    value.setDate(value.getDate() - 90);
                    break;
                case "this_month":
                    value = startOfMonth(now);
                    break;
                case "last_month":
                    value = startOfMonth(new Date(now.getFullYear(), now.getMonth() - 1, 1));
                    break;
                case "this_year":
                    value = startOfYear(now);
                    break;
                case "last_year":
                    value = startOfYear(new Date(now.getFullYear() - 1, 0, 1));
                    break;
                default:
                    return;
            }
            input.value = isDateTime ? formatDateTime(value) : formatDate(value);
            updateState();
        };

        const applyRangePreset = (startInput, endInput, preset, isDateTime) => {
            const { start, end } = resolvePresetRange(preset);
            if (!start || !end) return;
            const formatter = isDateTime ? formatDateTime : formatDate;
            startInput.value = formatter(start);
            endInput.value = formatter(end);
            updateState();
        };

        resetBtn.addEventListener("click", () => {
            getInputs().forEach(input => {
                input.value = initial.get(input.name) ?? "";
            });
            updateState();
        });

        applyBtn.addEventListener("click", () => {
            submitAction.value = "run";
            form.requestSubmit();
        });

        strip.addEventListener("click", (event) => {
            const button = event.target.closest(".query-param-presets [data-preset]");
            if (!button) return;
            const preset = button.getAttribute("data-preset");
            if (!preset) return;

            const dateGroup = button.closest("[data-param-date-group='true']");
            if (dateGroup) {
                const input = dateGroup.querySelector("[data-param-date='true']");
                if (!input) return;
                const isDateTime = input.dataset.paramKind === "datetime";
                applySinglePreset(input, preset, isDateTime);
                return;
            }

            const rangeGroup = button.closest("[data-param-range-group='true']");
            if (rangeGroup) {
                const startInput = rangeGroup.querySelector("[data-param-range='start']");
                const endInput = rangeGroup.querySelector("[data-param-range='end']");
                if (!startInput || !endInput) return;
                const isDateTime = rangeGroup.dataset.paramKind === "datetime";
                applyRangePreset(startInput, endInput, preset, isDateTime);
            }
        });

        const normalize = (value) => value.trim().toLowerCase();

        const parseTokens = (sql) => {
            const tokens = new Map();
            const regex = /{{\s*([\w.]+)\s*}}/g;
            let match;
            while ((match = regex.exec(sql)) !== null) {
                const raw = match[1].trim();
                const parts = raw.split(".");
                const key = normalize(parts[0]);
                const suffix = parts.length > 1 ? parts[1].toLowerCase() : null;
                const info = tokens.get(key) || { name: parts[0], hasRange: false };
                if (suffix === "start" || suffix === "end") {
                    info.hasRange = true;
                }
                tokens.set(key, info);
            }
            return tokens;
        };

        const getExistingNames = () => {
            const names = new Set();
            grid?.querySelectorAll(".query-param-card").forEach((card) => {
                const name = card.dataset.paramName;
                if (name) {
                    names.add(normalize(name));
                }
            });
            return names;
        };

        const createClientCard = (info) => {
            const card = document.createElement("div");
            card.className = "query-param-card";
            card.dataset.paramName = info.name;
            card.dataset.paramTitle = info.name;
            card.dataset.paramType = info.hasRange ? "DateRange" : "Text";
            card.dataset.paramDefault = "";
            card.dataset.paramSettings = "{}";
            card.dataset.paramRequired = "false";
            card.dataset.paramClient = "true";

            const label = document.createElement("div");
            label.className = "query-param-label";
            label.innerHTML = `<span>${info.name}</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="query-param-unsaved">Unsaved</span>
                    <button class="btn btn-link p-0 query-param-gear" type="button" title="Edit parameter">
                        <i class="bi bi-gear"></i>
                    </button>
                </div>`;
            card.appendChild(label);

            if (info.hasRange) {
                const wrap = document.createElement("div");
                wrap.className = "query-param-range-group";
                wrap.setAttribute("data-param-range-group", "true");
                wrap.setAttribute("data-param-kind", "date");
                wrap.innerHTML = `
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" type="date" data-param-input="true" data-param-range="start" name="ParameterValues[${info.name}.start]" />
                        <input class="form-control form-control-sm" type="date" data-param-input="true" data-param-range="end" name="ParameterValues[${info.name}.end]" />
                    </div>
                `;
                card.appendChild(wrap);
            } else {
                const input = document.createElement("input");
                input.className = "form-control form-control-sm";
                input.setAttribute("data-param-input", "true");
                input.name = `ParameterValues[${info.name}]`;
                input.placeholder = "Enter value";
                card.appendChild(input);
                const warning = document.createElement("div");
                warning.className = "form-text text-warning";
                warning.textContent = "Text parameters are unsafe for public links.";
                card.appendChild(warning);
            }

            return card;
        };

        const updateClientCards = (sql) => {
            if (!grid) return;
            const tokens = parseTokens(sql);
            grid.querySelectorAll(".query-param-card").forEach((card) => {
                const name = normalize(card.dataset.paramName || "");
                if (!tokens.has(name)) {
                    card.remove();
                }
            });

            const existing = getExistingNames();
            tokens.forEach((info, key) => {
                if (!existing.has(key)) {
                    const card = createClientCard(info);
                    grid.appendChild(card);
                }
            });

            refreshInputs();
            if (emptyMessage) {
                const hasAny = grid.querySelectorAll(".query-param-card").length > 0;
                emptyMessage.classList.toggle("d-none", hasAny);
            }
            if (missingAlert) {
                const hasClient = grid.querySelectorAll("[data-param-client='true']").length > 0;
                missingAlert.classList.toggle("d-none", hasClient);
            }
        };

        const getSqlText = () => {
            if (window.queryBuilderEditor) {
                return window.queryBuilderEditor.state.doc.toString();
            }
            const sqlInput = document.getElementById("SqlText");
            return sqlInput?.value || "";
        };

        const attachSqlListener = () => {
            if (window.queryBuilderEditor && !window.queryBuilderEditor.dom.dataset.paramTokenListener) {
                window.queryBuilderEditor.dom.dataset.paramTokenListener = "true";
                window.queryBuilderEditor.dom.addEventListener("keyup", () => updateClientCards(getSqlText()));
                window.queryBuilderEditor.dom.addEventListener("input", () => updateClientCards(getSqlText()));
                return true;
            }

            const sqlInput = document.getElementById("SqlText");
            if (sqlInput && !sqlInput.dataset.paramTokenListener) {
                sqlInput.dataset.paramTokenListener = "true";
                sqlInput.addEventListener("input", () => updateClientCards(getSqlText()));
                return true;
            }
            return false;
        };

        refreshInputs();
        let lastSql = getSqlText();
        updateClientCards(lastSql);
        if (!attachSqlListener()) {
            const timer = setInterval(() => {
                if (attachSqlListener()) {
                    clearInterval(timer);
                }
            }, 400);
        }

        setInterval(() => {
            const currentSql = getSqlText();
            if (currentSql !== lastSql) {
                lastSql = currentSql;
                updateClientCards(currentSql);
            }
        }, 500);

        window.queryBuilderParamStrip = {
            refreshInputs
        };
    })();
</script>

<script>
    (() => {
        const toggle = document.getElementById('showDataOnlyToggle');
        const editor = document.getElementById('queryEditorBody');
        if (!toggle || !editor) return;
        toggle.addEventListener('change', () => {
            editor.classList.toggle('d-none', toggle.checked);
        });
    })();
</script>

<script>
    (() => {
        const layout = document.querySelector('[data-split-layout="true"]');
        const leftPane = document.querySelector('[data-split-left="true"]');
        const splitter = document.getElementById('splitterVertical');
        const rightPane = document.querySelector('[data-split-right="true"]');
        if (!layout || !leftPane || !splitter || !rightPane) return;

        const storageKey = 'queryEditor.leftWidth';
        const defaultWidth = 320;
        const minLeft = 220;
        const rightMin = 480;
        const splitterWidth = 8;
        const mediaQuery = window.matchMedia('(max-width: 991.98px)');

        const getMaxLeft = () => {
            const maxByPercent = Math.floor(layout.clientWidth * 0.45);
            const maxByWidth = layout.clientWidth - rightMin - splitterWidth;
            return Math.max(minLeft, Math.min(520, maxByPercent, maxByWidth));
        };

        const applyWidth = (value) => {
            if (mediaQuery.matches) return;
            const maxLeft = getMaxLeft();
            const width = Math.max(minLeft, Math.min(maxLeft, value));
            leftPane.style.width = `${width}px`;
            window.dispatchEvent(new Event('resize'));
            window.queryBuilderEditor?.requestMeasure?.();
        };

        const resetWidth = () => {
            applyWidth(defaultWidth);
            localStorage.removeItem(storageKey);
        };

        window.queryBuilderSplit = window.queryBuilderSplit || {};
        window.queryBuilderSplit.resetVertical = resetWidth;

        const stored = Number(localStorage.getItem(storageKey));
        if (mediaQuery.matches) {
            resetWidth();
        } else if (!Number.isNaN(stored) && stored > 0) {
            applyWidth(stored);
        } else {
            applyWidth(defaultWidth);
        }

        let startX = 0;
        let startWidth = 0;
        let rafId = 0;

        const onPointerMove = (event) => {
            if (rafId) return;
            rafId = requestAnimationFrame(() => {
                rafId = 0;
                const delta = event.clientX - startX;
                applyWidth(startWidth + delta);
            });
        };

        const onPointerUp = (event) => {
            document.body.classList.remove('is-splitting');
            splitter.releasePointerCapture(event.pointerId);
            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);
            const currentWidth = leftPane.getBoundingClientRect().width;
            localStorage.setItem(storageKey, Math.round(currentWidth).toString());
        };

        splitter.addEventListener('pointerdown', (event) => {
            if (mediaQuery.matches) return;
            startX = event.clientX;
            startWidth = leftPane.getBoundingClientRect().width;
            splitter.setPointerCapture(event.pointerId);
            document.body.classList.add('is-splitting');
            document.addEventListener('pointermove', onPointerMove);
            document.addEventListener('pointerup', onPointerUp);
        });

        splitter.addEventListener('dblclick', () => resetWidth());

        mediaQuery.addEventListener('change', () => {
            if (mediaQuery.matches) {
                resetWidth();
                leftPane.style.width = '';
            } else {
                const latest = Number(localStorage.getItem(storageKey)) || defaultWidth;
                applyWidth(latest);
            }
        });
    })();
</script>

