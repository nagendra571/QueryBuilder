@model QueryBuilder.Web.Models.Queries.QueryEditViewModel

@{
    ViewData["Title"] = "New Query";
}

<div class="query-page">
    <form method="post" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        @if (Model.Id.HasValue)
        {
            <input type="hidden" asp-for="Id" />
        }
        <partial name="_QueryForm" />
    </form>
</div>

<partial name="_QueryParametersModal" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/paged-results.js" asp-append-version="true"></script>
}
