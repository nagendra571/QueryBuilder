@model QueryBuilder.Web.Models.Queries.QueryDetailsViewModel

@{
    ViewData["Title"] = "Query Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Name</h1>
        <div class="text-muted">@Model.DataSourceName · Updated @Model.UpdatedAt.ToLocalTime().ToString("g")</div>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="text-muted">@Model.Description</p>
}

<div class="card mb-4">
    <div class="card-header">
        <span class="fw-semibold">SQL</span>
    </div>
    <div class="card-body">
        <pre class="mb-0"><code>@Model.SqlText</code></pre>
    </div>
</div>

<div>
    <h2 class="h5 mb-2">Visualizations</h2>
    @if (Model.Visualizations.Count == 0)
    {
        <div class="text-muted">No visualizations yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var viz in Model.Visualizations)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@viz.Name</span>
                    <span class="badge text-bg-secondary">@viz.Type</span>
                </div>
            }
        </div>
    }
</div>
