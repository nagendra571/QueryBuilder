@model QueryBuilder.Web.Models.Dashboards.DashboardEditViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Edit Dashboard";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var widgetsJson = JsonSerializer.Serialize(Model.Widgets, jsonOptions);
    var visualsJson = JsonSerializer.Serialize(
        Model.AvailableVisualizations.Select(v => new { v.Id, v.Name, Type = v.Type.ToString() }),
        jsonOptions);
}

<div class="dashboard-page dashboard-edit">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Edit Dashboard</h1>
            <div class="text-muted">@Model.Name</div>
        </div>
        <a class="btn btn-outline-secondary" asp-action="View" asp-route-id="@Model.Id">View</a>
    </div>

    <div class="row">
        <div class="col-lg-3">
            <div class="card dashboard-panel mb-3">
                <div class="card-body">
                    <form method="post" asp-action="Create">
                        <input type="hidden" name="Id" value="@Model.Id" />
                    </form>
                    <div class="mb-3">
                        <label class="form-label">Add Visualization</label>
                        <select id="vizSelect" class="form-select">
                            <option value="">Select visualization</option>
                            @foreach (var viz in Model.AvailableVisualizations)
                            {
                                <option value="@viz.Id">@viz.Name (@viz.Type)</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary w-100" type="button" id="addWidgetBtn">
                        <i class="bi bi-plus-circle me-2"></i>Add Widget
                    </button>
                </div>
            </div>

            <div class="card dashboard-panel">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <button class="btn btn-outline-primary w-100" type="button" id="saveLayoutBtn">
                        <i class="bi bi-check2-circle me-2"></i>Save Layout
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <partial name="_ShareSection" model="Model.ShareSection" />
            </div>
        </div>
        <div class="col-lg-9">
            <div class="dashboard-grid-header">
                <div class="text-muted small">Edit mode · Drag tiles to rearrange and resize.</div>
                <a class="btn btn-sm btn-outline-secondary" asp-action="View" asp-route-id="@Model.Id">Preview</a>
            </div>
            <div class="grid-stack dashboard-grid"></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.min.js"></script>
    <script>
        window.dashboardBuilder = {
            dashboardId: @Model.Id,
            widgets: @Html.Raw(widgetsJson),
            visualizations: @Html.Raw(visualsJson),
            editMode: true
        };
    </script>
    <script src="~/js/dashboards.js" asp-append-version="true"></script>
}
