@model QueryBuilder.Web.Models.Dashboards.DashboardEditViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Edit Dashboard";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var widgetsJson = JsonSerializer.Serialize(Model.Widgets, jsonOptions);
    var controlsJson = JsonSerializer.Serialize(
        Model.ParameterControls.Select(c => new { c.Key, c.Title, Type = c.Type.ToString() }),
        jsonOptions);
}

<div class="dashboard-page dashboard-edit">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Edit Dashboard</h1>
            <div class="text-muted">@Model.Name</div>
        </div>
        <a class="btn btn-outline-secondary" asp-action="View" asp-route-id="@Model.Id">View</a>
    </div>

    <div class="row">
        <div class="col-lg-3">
            <div class="card dashboard-panel mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="mb-0">Add Widget</h6>
                        <span class="text-muted small">Pick a query + visualization</span>
                    </div>
                    <button class="btn btn-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#addWidgetModal">
                        <i class="bi bi-plus-circle me-2"></i>Add Widget
                    </button>
                </div>
            </div>

            <div class="card dashboard-panel mb-3">
                <div class="card-body">
                    <h6 class="mb-3">Dashboard Parameters</h6>
                    <form method="post" asp-action="SaveParameterControls" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="DashboardId" value="@Model.Id" />
                        <div id="dashboardControlsList">
                            @{
                                var controlIndex = 0;
                            }
                            @foreach (var control in Model.ParameterControls)
                            {
                                <div class="border rounded p-2 mb-2 dashboard-control-row">
                                    <input type="hidden" name="Controls[@controlIndex].Id" value="@control.Id" />
                                    <div class="mb-2">
                                        <label class="form-label">Key</label>
                                        <input class="form-control form-control-sm" name="Controls[@controlIndex].Key" value="@control.Key" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Title</label>
                                        <input class="form-control form-control-sm" name="Controls[@controlIndex].Title" value="@control.Title" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Type</label>
                                        <select class="form-select form-select-sm" name="Controls[@controlIndex].Type">
                                            @foreach (var type in Enum.GetValues<QueryBuilder.Domain.Entities.QueryParameterType>())
                                            {
                                                <option value="@type" selected="@(type.Equals(control.Type) ? "selected" : null)">@type</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Default</label>
                                        <input class="form-control form-control-sm" name="Controls[@controlIndex].DefaultValue" value="@control.DefaultValue" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Placement</label>
                                        <select class="form-select form-select-sm" name="Controls[@controlIndex].Placement">
                                            @foreach (var placement in Enum.GetValues<QueryBuilder.Domain.Entities.DashboardParameterPlacement>())
                                            {
                                                <option value="@placement" selected="@(placement.Equals(control.Placement) ? "selected" : null)">@placement</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label">Settings JSON</label>
                                        <textarea class="form-control form-control-sm" name="Controls[@controlIndex].SettingsJson" rows="2">@control.SettingsJson</textarea>
                                    </div>
                                </div>
                                controlIndex++;
                            }
                        </div>
                        <button class="btn btn-outline-secondary w-100 mb-2" type="button" id="addDashboardControlBtn">
                            <i class="bi bi-plus-circle me-2"></i>Add Control
                        </button>
                        <button class="btn btn-outline-primary w-100" type="submit">Save Controls</button>
                    </form>
                </div>
            </div>

            <div class="card dashboard-panel mb-3" id="widgetParameterMappingCard">
                <div class="card-body">
                    <h6 class="mb-3">Widget Parameter Mapping</h6>
                    @if (Model.WidgetParameters.Count == 0)
                    {
                        <div class="text-muted small">No parameterized queries in this dashboard yet.</div>
                    }
                    else
                    {
                        <form method="post" asp-action="SaveParameterMappings" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="DashboardId" value="@Model.Id" />
                            @{
                                var mapIndex = 0;
                            }
                            @foreach (var widget in Model.WidgetParameters)
                            {
                                <div class="border rounded p-2 mb-3">
                                    <div class="fw-semibold mb-2">@widget.VisualizationName</div>
                                    @foreach (var param in widget.Parameters)
                                    {
                                        var mapping = widget.Mappings.FirstOrDefault(m => m.QueryParamKey == param.Name)
                                            ?? new QueryBuilder.Web.Models.Dashboards.DashboardParameterMappingViewModel
                                            {
                                                QueryParamKey = param.Name,
                                                BindingType = QueryBuilder.Domain.Entities.DashboardParameterBindingType.InlineControl
                                            };
                                        <div class="mb-2">
                                            <div class="small fw-semibold">@param.Title</div>
                                            <input type="hidden" name="Mappings[@mapIndex].DashboardWidgetId" value="@widget.WidgetId" />
                                            <input type="hidden" name="Mappings[@mapIndex].QueryId" value="@widget.QueryId" />
                                            <input type="hidden" name="Mappings[@mapIndex].QueryParamKey" value="@param.Name" />
                                            <div class="row g-2 align-items-center">
                                                <div class="col-5">
                                                    <select class="form-select form-select-sm param-binding-select" name="Mappings[@mapIndex].BindingType" data-map-index="@mapIndex">
                                                        <option value="InlineControl" selected="@(mapping.BindingType == QueryBuilder.Domain.Entities.DashboardParameterBindingType.InlineControl ? "selected" : null)">Inline</option>
                                                        <option value="DashboardControlKey" selected="@(mapping.BindingType == QueryBuilder.Domain.Entities.DashboardParameterBindingType.DashboardControlKey ? "selected" : null)">Dashboard Control</option>
                                                        <option value="StaticValue" selected="@(mapping.BindingType == QueryBuilder.Domain.Entities.DashboardParameterBindingType.StaticValue ? "selected" : null)">Static Value</option>
                                                    </select>
                                                </div>
                                                <div class="col-7">
                                                    <select class="form-select form-select-sm param-control-key @(mapping.BindingType == QueryBuilder.Domain.Entities.DashboardParameterBindingType.DashboardControlKey ? "" : "d-none")" name="Mappings[@mapIndex].ControlKey">
                                                        <option value="">Select control</option>
                                                        @foreach (var control in Model.ParameterControls)
                                                        {
                                                            <option value="@control.Key" selected="@(control.Key == mapping.ControlKey ? "selected" : null)">@control.Title</option>
                                                        }
                                                    </select>
                                                    <div class="param-static-wrapper @(mapping.BindingType == QueryBuilder.Domain.Entities.DashboardParameterBindingType.StaticValue ? "" : "d-none")">
                                                        @if (param.Type == QueryBuilder.Domain.Entities.QueryParameterType.DateRange || param.Type == QueryBuilder.Domain.Entities.QueryParameterType.DateTimeRange)
                                                        {
                                                            var rangeType = param.Type == QueryBuilder.Domain.Entities.QueryParameterType.DateRange ? "date" : "datetime-local";
                                                            string? startValue = null;
                                                            string? endValue = null;
                                                            if (!string.IsNullOrWhiteSpace(mapping.StaticValue))
                                                            {
                                                                try
                                                                {
                                                                    using var doc = JsonDocument.Parse(mapping.StaticValue);
                                                                    if (doc.RootElement.ValueKind == JsonValueKind.Object)
                                                                    {
                                                                        startValue = doc.RootElement.TryGetProperty("start", out var startElement) ? startElement.GetString() : null;
                                                                        endValue = doc.RootElement.TryGetProperty("end", out var endElement) ? endElement.GetString() : null;
                                                                    }
                                                                }
                                                                catch (JsonException)
                                                                {
                                                                }
                                                            }
                                                            <div class="d-flex gap-2">
                                                                <input class="form-control form-control-sm" type="@rangeType" name="Mappings[@mapIndex].StaticValueStart" value="@startValue" />
                                                                <input class="form-control form-control-sm" type="@rangeType" name="Mappings[@mapIndex].StaticValueEnd" value="@endValue" />
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <input class="form-control form-control-sm" name="Mappings[@mapIndex].StaticValue" value="@mapping.StaticValue" />
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        mapIndex++;
                                    }
                                </div>
                            }
                            <button class="btn btn-outline-primary w-100" type="submit">Save Mappings</button>
                        </form>
                    }
                </div>
            </div>

            <div class="card dashboard-panel">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <button class="btn btn-outline-primary w-100" type="button" id="saveLayoutBtn">
                        <i class="bi bi-check2-circle me-2"></i>Save Layout
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <partial name="_ShareSection" model="Model.ShareSection" />
            </div>
        </div>
        <div class="col-lg-9">
            <div class="dashboard-grid-header">
    <div class="text-muted small">Edit mode ? Drag tiles to rearrange and resize.</div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addWidgetModal">
            <i class="bi bi-plus-circle me-1"></i>Add Widget
        </button>
        <a class="btn btn-sm btn-outline-secondary" asp-action="View" asp-route-id="@Model.Id">Preview</a>
    </div>
</div>
<div class="grid-stack dashboard-grid"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="addWidgetModal" tabindex="-1" aria-labelledby="addWidgetLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWidgetLabel">Add Widget</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Query</label>
                        <select class="form-select" id="widgetQuerySelect">
                            <option value="">Select query</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Visualization</label>
                        <select class="form-select" id="widgetVisualizationSelect">
                            <option value="">Select visualization</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="mb-0">Parameters</h6>
                        <span class="text-muted small">Map each parameter to a value source.</span>
                    </div>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm align-middle mb-0" id="widgetParamTable">
                            <thead>
                            <tr>
                                <th>Title</th>
                                <th>Keyword</th>
                                <th>Value Source</th>
                                <th>Value</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr class="text-muted">
                                <td colspan="4">Select a visualization to configure parameters.</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAddWidgetBtn" disabled>Add to Dashboard</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="widgetMappingModal" tabindex="-1" aria-labelledby="widgetMappingLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="widgetMappingLabel">Edit Source and Value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mappingSource" id="mappingNew" value="new">
                        <label class="form-check-label" for="mappingNew">New dashboard parameter</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mappingSource" id="mappingExisting" value="existing">
                        <label class="form-check-label" for="mappingExisting">Existing dashboard parameter</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mappingSource" id="mappingWidget" value="widget" checked>
                        <label class="form-check-label" for="mappingWidget">Widget parameter</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mappingSource" id="mappingStatic" value="static">
                        <label class="form-check-label" for="mappingStatic">Static value</label>
                    </div>
                </div>

                <div class="mb-3 d-none" id="mappingNewFields">
                    <label class="form-label">Key</label>
                    <input class="form-control" id="mappingNewKey" placeholder="Date Range" />
                    <label class="form-label mt-2">Title</label>
                    <input class="form-control" id="mappingNewTitle" placeholder="Effective Date" />
                </div>

                <div class="mb-3 d-none" id="mappingExistingFields">
                    <label class="form-label">Dashboard parameter</label>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" id="mappingExistingSelect"></select>
                        <button type="button" class="btn btn-outline-primary" id="mappingQuickCreateBtn">Create</button>
                    </div>
                    <div class="form-text">Create a new dashboard parameter and select it immediately.</div>
                </div>

                <div class="mb-3 d-none" id="mappingStaticFields">
                    <label class="form-label">Value</label>
                    <div id="mappingStaticInput"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveMappingBtn">OK</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.min.js"></script>
    <script>
        window.dashboardBuilder = {
            dashboardId: @Model.Id,
            widgets: @Html.Raw(widgetsJson),
            parameterControls: @Html.Raw(controlsJson),
            editMode: true
        };
    </script>
    <script src="~/js/dashboards.js" asp-append-version="true"></script>
    <script>
        const parameterTypes = @Html.Raw(JsonSerializer.Serialize(Enum.GetValues<QueryBuilder.Domain.Entities.QueryParameterType>()));
        const parameterPlacements = @Html.Raw(JsonSerializer.Serialize(Enum.GetValues<QueryBuilder.Domain.Entities.DashboardParameterPlacement>()));
        const addControlBtn = document.getElementById("addDashboardControlBtn");
        const controlsList = document.getElementById("dashboardControlsList");
        if (addControlBtn && controlsList) {
            addControlBtn.addEventListener("click", () => {
                const index = controlsList.querySelectorAll(".dashboard-control-row").length;
                const row = document.createElement("div");
                row.className = "border rounded p-2 mb-2 dashboard-control-row";
                row.innerHTML = `
                    <div class="mb-2">
                        <label class="form-label">Key</label>
                        <input class="form-control form-control-sm" name="Controls[${index}].Key" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Title</label>
                        <input class="form-control form-control-sm" name="Controls[${index}].Title" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Type</label>
                        <select class="form-select form-select-sm" name="Controls[${index}].Type">
                            ${parameterTypes.map(type => `<option value="${type}">${type}</option>`).join("")}
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Default</label>
                        <input class="form-control form-control-sm" name="Controls[${index}].DefaultValue" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Placement</label>
                        <select class="form-select form-select-sm" name="Controls[${index}].Placement">
                            ${parameterPlacements.map(type => `<option value="${type}">${type}</option>`).join("")}
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Settings JSON</label>
                        <textarea class="form-control form-control-sm" name="Controls[${index}].SettingsJson" rows="2"></textarea>
                    </div>`;
                controlsList.appendChild(row);
            });
        }

        document.querySelectorAll(".param-binding-select").forEach(select => {
            select.addEventListener("change", (event) => {
                const wrapper = event.target.closest(".row");
                if (!wrapper) return;
                const controlSelect = wrapper.querySelector(".param-control-key");
                const staticWrapper = wrapper.querySelector(".param-static-wrapper");
                const value = event.target.value;
                if (controlSelect) {
                    controlSelect.classList.toggle("d-none", value !== "DashboardControlKey");
                }
                if (staticWrapper) {
                    staticWrapper.classList.toggle("d-none", value !== "StaticValue");
                }
            });
        });
    </script>
}
