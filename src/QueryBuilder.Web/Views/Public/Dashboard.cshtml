@model QueryBuilder.Web.Models.Dashboards.DashboardViewModel
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    ViewData["Title"] = Model.Dashboard.Name;
    Layout = "_Layout";
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter() }
    };
}

<div class="dashboard-page dashboard-view dashboard-public">
    <div class="dashboard-titlebar">
        <div>
            <h1 class="h3 mb-0">@Model.Dashboard.Name</h1>
            <div class="text-muted">@Model.Dashboard.Description</div>
        </div>
    </div>

    @if (Model.Widgets.Count == 0)
    {
        <div class="dashboard-empty">
            <div class="dashboard-empty-card">
                <div class="dashboard-empty-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <div class="dashboard-empty-title">This dashboard is empty</div>
                <div class="dashboard-empty-text">No widgets available to display.</div>
            </div>
        </div>
    }
    else
    {
        var hasTopControls = Model.ParameterControls.Any(c => c.Placement == QueryBuilder.Domain.Entities.DashboardParameterPlacement.TopBar);
        var hasInlineControls = Model.WidgetParameters.Any(w => w.Parameters.Count > 0);
        if (hasTopControls || hasInlineControls)
        {
            <div class="dashboard-parameter-bar mb-3" id="dashboardParameterBar">
                @if (hasTopControls)
                {
                    <div class="dashboard-parameter-grid">
                        @foreach (var control in Model.ParameterControls.Where(c => c.Placement == QueryBuilder.Domain.Entities.DashboardParameterPlacement.TopBar))
                        {
                            <div class="dashboard-parameter-field">
                                <label class="form-label">@control.Title</label>
                                @{
                                    var key = control.Key;
                                    var values = Model.ParameterState.DashboardControlValues;
                                }
                                @switch (control.Type)
                                {
                                    case QueryBuilder.Domain.Entities.QueryParameterType.Number:
                                        <input class="form-control form-control-sm" type="number" name="dc_@key" value="@(values.TryGetValue(key, out var numVal) ? numVal : control.DefaultValue)" data-dashboard-control="true" />
                                        break;
                                    case QueryBuilder.Domain.Entities.QueryParameterType.Dropdown:
                                        var options = new List<QueryBuilder.Web.Models.Queries.QueryParameterOptionViewModel>();
                                        if (!string.IsNullOrWhiteSpace(control.SettingsJson))
                                        {
                                            using var doc = JsonDocument.Parse(control.SettingsJson);
                                            if (doc.RootElement.TryGetProperty("options", out var optionsElement) &&
                                                optionsElement.ValueKind == JsonValueKind.Array)
                                            {
                                                foreach (var option in optionsElement.EnumerateArray())
                                                {
                                                    if (!option.TryGetProperty("value", out var valueElement))
                                                    {
                                                        continue;
                                                    }
                                                    var value = valueElement.GetString();
                                                    var label = option.TryGetProperty("label", out var labelElement)
                                                        ? labelElement.GetString()
                                                        : value;
                                                    if (!string.IsNullOrWhiteSpace(value))
                                                    {
                                                        options.Add(new QueryBuilder.Web.Models.Queries.QueryParameterOptionViewModel
                                                        {
                                                            Label = label ?? value!,
                                                            Value = value!
                                                        });
                                                    }
                                                }
                                            }
                                        }
                                        <select class="form-select form-select-sm" name="dc_@key" data-dashboard-control="true">
                                            <option value="">Select</option>
                                            @foreach (var opt in options)
                                            {
                                                var selected = values.TryGetValue(key, out var val) ? val == opt.Value : opt.Value == control.DefaultValue;
                                                <option value="@opt.Value" selected="@(selected ? "selected" : null)">@opt.Label</option>
                                            }
                                        </select>
                                        break;
                                    case QueryBuilder.Domain.Entities.QueryParameterType.Date:
                                        <input class="form-control form-control-sm" type="date" name="dc_@key" value="@(values.TryGetValue(key, out var dateVal) ? dateVal : control.DefaultValue)" data-dashboard-control="true" />
                                        break;
                                    case QueryBuilder.Domain.Entities.QueryParameterType.DateTime:
                                        <input class="form-control form-control-sm" type="datetime-local" name="dc_@key" value="@(values.TryGetValue(key, out var dtVal) ? dtVal : control.DefaultValue)" data-dashboard-control="true" />
                                        break;
                                    case QueryBuilder.Domain.Entities.QueryParameterType.DateRange:
                                    case QueryBuilder.Domain.Entities.QueryParameterType.DateTimeRange:
                                        var inputType = control.Type == QueryBuilder.Domain.Entities.QueryParameterType.DateRange ? "date" : "datetime-local";
                                        <div class="d-flex gap-2">
                                            <input class="form-control form-control-sm" type="@inputType" name="@($"dc_{key}_start")" value="@(values.TryGetValue($"{key}.start", out var startVal) ? startVal : string.Empty)" data-dashboard-control="true" />
                                            <input class="form-control form-control-sm" type="@inputType" name="@($"dc_{key}_end")" value="@(values.TryGetValue($"{key}.end", out var endVal) ? endVal : string.Empty)" data-dashboard-control="true" />
                                        </div>
                                        break;
                                    default:
                                        <input class="form-control form-control-sm" type="text" name="dc_@key" value="@(values.TryGetValue(key, out var textVal) ? textVal : control.DefaultValue)" data-dashboard-control="true" />
                                        break;
                                }
                            </div>
                        }
                    </div>
                }
                <div class="dashboard-parameter-actions">
                    <button class="btn btn-sm btn-primary" type="button" id="dashboardApplyBtn">Apply</button>
                </div>
            </div>
        }
        <div class="grid-stack dashboard-grid"></div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const widgets = [];
        const widgetParameters = @Html.Raw(JsonSerializer.Serialize(Model.WidgetParameters, jsonOptions));
        const parameterState = @Html.Raw(JsonSerializer.Serialize(Model.ParameterState, jsonOptions));
        @foreach (var widget in Model.Widgets)
        {
            var rowsJson = JsonSerializer.Serialize(widget.Result.Rows);
            var colsJson = JsonSerializer.Serialize(widget.Result.Columns);
            <text>
            widgets.push({
                id: @widget.Widget.Id,
                x: @widget.Widget.X,
                y: @widget.Widget.Y,
                w: @widget.Widget.Width,
                h: @widget.Widget.Height,
                visualizationId: @widget.Visualization.Id,
                visualizationName: "@widget.Visualization.Name",
                visualizationType: "@widget.Visualization.Type",
                queryId: @widget.Visualization.QueryId,
                autoRefreshEnabled: @widget.Visualization.IsAutoRefreshEnabled.ToString().ToLowerInvariant(),
                autoRefreshInterval: @(widget.Visualization.AutoRefreshIntervalSeconds ?? 0),
                columns: @Html.Raw(colsJson),
                rows: @Html.Raw(rowsJson),
                xColumn: "@(widget.Config.XColumn ?? string.Empty)",
                yColumn: "@(widget.Config.YColumn ?? string.Empty)",
                yColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(widget.Config.YColumns)),
                labelColumn: "@(widget.Config.LabelColumn ?? string.Empty)",
                valueColumn: "@(widget.Config.ValueColumn ?? string.Empty)",
                showLegend: @widget.Config.ShowLegend.ToString().ToLowerInvariant()
            });
            </text>
        }

        window.queryBuilderViz = window.queryBuilderViz || {};
        window.queryBuilderViz.multi = [];

        const grid = GridStack.init({ staticGrid: true, margin: 8, cellHeight: 80, float: true });
        widgets.forEach(widget => {
            const content = document.createElement('div');
            content.className = 'grid-stack-item-content dashboard-widget';
            content.dataset.widgetId = widget.id;
            content.dataset.visualizationId = widget.visualizationId;
            content.dataset.visualizationType = widget.visualizationType;
            const header = document.createElement('div');
            header.className = 'dashboard-widget-header';
            const title = document.createElement('div');
            title.className = 'dashboard-widget-title';
            title.textContent = widget.visualizationName;
            const actions = document.createElement('div');
            actions.className = 'dashboard-widget-actions';
            const badge = document.createElement('span');
            badge.className = 'badge bg-light text-dark border';
            badge.textContent = widget.visualizationType;
            actions.appendChild(badge);
            header.appendChild(title);
            header.appendChild(actions);

            const body = document.createElement('div');
            body.className = 'dashboard-widget-body';
            body.dataset.widgetBody = widget.id;

            if (widget.visualizationType === "Table") {
                const table = document.createElement('table');
                table.className = 'table table-sm table-hover mb-0';
                const thead = document.createElement('thead');
                const headRow = document.createElement('tr');
                widget.columns.forEach(col => {
                    const th = document.createElement('th');
                    th.textContent = col;
                    headRow.appendChild(th);
                });
                thead.appendChild(headRow);
                table.appendChild(thead);
                const tbody = document.createElement('tbody');
                widget.rows.forEach(row => {
                    const tr = document.createElement('tr');
                    row.forEach(cell => {
                        const td = document.createElement('td');
                        td.textContent = cell ?? '';
                        tr.appendChild(td);
                    });
                    tbody.appendChild(tr);
                });
                table.appendChild(tbody);
                body.appendChild(table);
            } else {
                const canvas = document.createElement('canvas');
                canvas.id = `viz-${widget.id}`;
                body.appendChild(canvas);
                window.queryBuilderViz.multi.push({
                    canvasId: canvas.id,
                    type: widget.visualizationType,
                    columns: widget.columns,
                    rows: widget.rows,
                    xColumn: widget.xColumn,
                    yColumn: widget.yColumn,
                    yColumns: widget.yColumns,
                    labelColumn: widget.labelColumn,
                    valueColumn: widget.valueColumn,
                    showLegend: widget.showLegend
                });
            }

            content.appendChild(header);
            content.appendChild(body);
            grid.addWidget({ w: widget.w, h: widget.h, x: widget.x, y: widget.y, content: content.outerHTML });
        });
    </script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script>
        window.dashboardParameters = {
            widgetParameters: widgetParameters,
            parameterState: parameterState
        };
        const publicToken = "@Context.Request.RouteValues["token"]";
        window.dashboardParameterConfig = {
            mode: "public",
            widgets: widgets.map(widget => ({
                id: widget.id,
                widgetId: widget.id,
                visualizationType: widget.visualizationType,
                endpoint: `/public/data/d/${publicToken}/w/${widget.id}`
            }))
        };
    </script>
    <script src="~/js/dashboard-parameters.js" asp-append-version="true"></script>
    <script>
        if (window.dashboardParameters?.renderInlineControls) {
            widgets.forEach(widget => {
                const header = document.querySelector(`[data-widget-id='${widget.id}'] .dashboard-widget-header`);
                if (header) {
                    window.dashboardParameters.renderInlineControls(widget.id, header);
                }
            });
        }
    </script>
    <script>
        window.autoRefreshConfig = {
            mode: "public-dashboard",
            token: publicToken,
            widgets: widgets.map(widget => ({
                widgetId: widget.id,
                visualizationId: widget.visualizationId,
                visualizationType: widget.visualizationType,
                autoRefreshEnabled: widget.autoRefreshEnabled,
                autoRefreshInterval: widget.autoRefreshInterval,
                endpoint: `/public/data/d/${publicToken}/w/${widget.id}`
            }))
        };
    </script>
    <script src="~/js/auto-refresh.js" asp-append-version="true"></script>
}
