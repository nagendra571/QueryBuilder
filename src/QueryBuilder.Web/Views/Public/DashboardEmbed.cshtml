@model QueryBuilder.Web.Models.Dashboards.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Dashboard.Name;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Dashboard.Name</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-embed">
    <div class="dashboard-page dashboard-view dashboard-embed">
        @if (Model.Widgets.Count == 0)
        {
            <div class="dashboard-empty">
                <div class="dashboard-empty-card">
                    <div class="dashboard-empty-title">No widgets available.</div>
                </div>
            </div>
        }
        else
        {
            <div class="grid-stack dashboard-grid"></div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const widgets = [];
        @foreach (var widget in Model.Widgets)
        {
            var rowsJson = JsonSerializer.Serialize(widget.Result.Rows);
            var colsJson = JsonSerializer.Serialize(widget.Result.Columns);
            <text>
            widgets.push({
                id: @widget.Widget.Id,
                x: @widget.Widget.X,
                y: @widget.Widget.Y,
                w: @widget.Widget.Width,
                h: @widget.Widget.Height,
                visualizationId: @widget.Visualization.Id,
                visualizationName: "@widget.Visualization.Name",
                visualizationType: "@widget.Visualization.Type",
                autoRefreshEnabled: @widget.Visualization.IsAutoRefreshEnabled.ToString().ToLowerInvariant(),
                autoRefreshInterval: @(widget.Visualization.AutoRefreshIntervalSeconds ?? 0),
                columns: @Html.Raw(colsJson),
                rows: @Html.Raw(rowsJson),
                xColumn: "@(widget.Config.XColumn ?? string.Empty)",
                yColumn: "@(widget.Config.YColumn ?? string.Empty)",
                yColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(widget.Config.YColumns)),
                labelColumn: "@(widget.Config.LabelColumn ?? string.Empty)",
                valueColumn: "@(widget.Config.ValueColumn ?? string.Empty)",
                showLegend: @widget.Config.ShowLegend.ToString().ToLowerInvariant()
            });
            </text>
        }

        window.queryBuilderViz = window.queryBuilderViz || {};
        window.queryBuilderViz.multi = [];

        const grid = GridStack.init({ staticGrid: true, margin: 8, cellHeight: 80, float: true });
        widgets.forEach(widget => {
            const content = document.createElement('div');
            content.className = 'grid-stack-item-content dashboard-widget';
            content.dataset.widgetId = widget.id;
            content.dataset.visualizationId = widget.visualizationId;
            content.dataset.visualizationType = widget.visualizationType;
            const header = document.createElement('div');
            header.className = 'dashboard-widget-header';
            const title = document.createElement('div');
            title.className = 'dashboard-widget-title';
            title.textContent = widget.visualizationName;
            header.appendChild(title);

            const body = document.createElement('div');
            body.className = 'dashboard-widget-body';
            body.dataset.widgetBody = widget.id;

            if (widget.visualizationType === "Table") {
                const table = document.createElement('table');
                table.className = 'table table-sm table-hover mb-0';
                const thead = document.createElement('thead');
                const headRow = document.createElement('tr');
                widget.columns.forEach(col => {
                    const th = document.createElement('th');
                    th.textContent = col;
                    headRow.appendChild(th);
                });
                thead.appendChild(headRow);
                table.appendChild(thead);
                const tbody = document.createElement('tbody');
                widget.rows.forEach(row => {
                    const tr = document.createElement('tr');
                    row.forEach(cell => {
                        const td = document.createElement('td');
                        td.textContent = cell ?? '';
                        tr.appendChild(td);
                    });
                    tbody.appendChild(tr);
                });
                table.appendChild(tbody);
                body.appendChild(table);
            } else {
                const canvas = document.createElement('canvas');
                canvas.id = `viz-${widget.id}`;
                body.appendChild(canvas);
                window.queryBuilderViz.multi.push({
                    canvasId: canvas.id,
                    type: widget.visualizationType,
                    columns: widget.columns,
                    rows: widget.rows,
                    xColumn: widget.xColumn,
                    yColumn: widget.yColumn,
                    yColumns: widget.yColumns,
                    labelColumn: widget.labelColumn,
                    valueColumn: widget.valueColumn,
                    showLegend: widget.showLegend
                });
            }

            content.appendChild(header);
            content.appendChild(body);
            grid.addWidget({ w: widget.w, h: widget.h, x: widget.x, y: widget.y, content: content.outerHTML });
        });
    </script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script>
        const publicToken = "@Context.Request.RouteValues["token"]";
        window.autoRefreshConfig = {
            mode: "public-embed",
            token: publicToken,
            widgets: widgets.map(widget => ({
                widgetId: widget.id,
                visualizationId: widget.visualizationId,
                visualizationType: widget.visualizationType,
                autoRefreshEnabled: widget.autoRefreshEnabled,
                autoRefreshInterval: widget.autoRefreshInterval,
                endpoint: `/public/data/d/${publicToken}/w/${widget.id}`
            }))
        };
    </script>
    <script src="~/js/auto-refresh.js" asp-append-version="true"></script>
</body>
</html>
