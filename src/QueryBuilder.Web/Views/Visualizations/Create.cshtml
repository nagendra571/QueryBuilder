@model QueryBuilder.Web.Models.Visualizations.VisualizationEditViewModel

@{
    ViewData["Title"] = ViewData["Title"] as string ?? "New Visualization";
    var actionLabel = Model.Id.HasValue ? "Edit" : "New";
}

<div class="viz-editor">
    <div class="viz-shell">
        <div class="viz-header">
            <div>
                <div class="h5 mb-0">@actionLabel Visualization</div>
                <div class="text-muted small">Query @Model.QueryId</div>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Queries" asp-action="Edit" asp-route-id="@Model.QueryId">Close</a>
        </div>

        <div class="viz-body">
            <form method="post" class="viz-config viz-card">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="QueryId" />

                <partial name="_VisualizationParameters" model="Model" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <ul class="nav nav-tabs viz-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#vizGeneral" type="button" role="tab">General</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizXAxis" type="button" role="tab">X Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizYAxis" type="button" role="tab">Y Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizSeries" type="button" role="tab">Series</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="vizGeneral" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" class="form-select" asp-items="ViewBag.VisualizationTypes"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="ShowLegend" class="form-check-input" />
                            <label asp-for="ShowLegend" class="form-check-label"></label>
                        </div>
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsAutoRefreshEnabled" class="form-check-input" id="autoRefreshToggle" />
                                <label asp-for="IsAutoRefreshEnabled" class="form-check-label"></label>
                            </div>
                            <div class="mb-2">
                                <label asp-for="AutoRefreshIntervalSeconds" class="form-label"></label>
                                <select asp-for="AutoRefreshIntervalSeconds" class="form-select" id="autoRefreshInterval">
                                    <option value="">Select interval</option>
                                    <option value="30">30 seconds</option>
                                    <option value="60">1 minute</option>
                                    <option value="300">5 minutes</option>
                                    <option value="600">10 minutes</option>
                                    <option value="1800">30 minutes</option>
                                    <option value="3600">60 minutes</option>
                                </select>
                                <span asp-validation-for="AutoRefreshIntervalSeconds" class="text-danger"></span>
                            </div>
                            <div class="form-text text-warning">
                                Auto refresh may increase system load for complex queries.
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizXAxis" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="XColumn" class="form-label"></label>
                            <select asp-for="XColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="GroupByColumn" class="form-label"></label>
                            <select asp-for="GroupByColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                            <div class="form-text">Optional. Stored for future grouping logic.</div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizYAxis" role="tabpanel">
                        <div class="border rounded-3 p-3 bg-light mb-3 @(Model.Type == QueryBuilder.Domain.Entities.VisualizationType.Bar || Model.Type == QueryBuilder.Domain.Entities.VisualizationType.FloatingBar || Model.Type == QueryBuilder.Domain.Entities.VisualizationType.HorizontalBar ? "" : "d-none")" id="floatingBarSettings">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="UseHorizontalBars" class="form-check-input" id="horizontalBarsToggle" />
                                <label asp-for="UseHorizontalBars" class="form-check-label"></label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="UseStackedBars" class="form-check-input" id="stackedBarsToggle" />
                                <label asp-for="UseStackedBars" class="form-check-label"></label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input asp-for="UseFloatingBars" class="form-check-input" id="floatingBarsToggle" />
                                <label asp-for="UseFloatingBars" class="form-check-label"></label>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label asp-for="RangeStartColumn" class="form-label"></label>
                                    <select asp-for="RangeStartColumn" class="form-select">
                                        <option value="">--</option>
                                        @foreach (var column in Model.Columns)
                                        {
                                            <option value="@column">@column</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="RangeEndColumn" class="form-label"></label>
                                    <select asp-for="RangeEndColumn" class="form-select">
                                        <option value="">--</option>
                                        @foreach (var column in Model.Columns)
                                        {
                                            <option value="@column">@column</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-text">Use two columns to render floating bar ranges.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="YColumns" class="form-label"></label>
                            <select asp-for="YColumns" class="form-select" multiple size="6" id="yColumnsSelect">
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column" selected="@(Model.YColumns.Contains(column) ? "selected" : null)">@column</option>
                                }
                            </select>
                            <div class="form-text">Select one or more series.</div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizSeries" role="tabpanel">
                        <div class="border rounded-3 p-3 bg-light mb-3 @(Model.Type == QueryBuilder.Domain.Entities.VisualizationType.Line ? "" : "d-none")" id="lineInterpolationPanel">
                            <label asp-for="LineInterpolationMode" class="form-label"></label>
                            <select asp-for="LineInterpolationMode" class="form-select" id="lineInterpolationSelect">
                                <option value="default">Default</option>
                                <option value="monotone">Monotone</option>
                                <option value="linear">Linear</option>
                            </select>
                            <div class="form-text">Controls how line segments are interpolated between points.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LabelColumn" class="form-label"></label>
                            <select asp-for="LabelColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ValueColumn" class="form-label"></label>
                            <select asp-for="ValueColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="viz-actions d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" type="submit" name="SubmitAction" value="preview">Preview</button>
                    <button class="btn btn-primary" type="submit" name="SubmitAction" value="save">Save</button>
                </div>
            </form>

            <div class="viz-preview viz-card">
                @if (Model.Result != null && !Model.Result.Success)
                {
                    <div class="alert alert-warning">@Model.Result.ErrorMessage</div>
                }
                else if (Model.Result != null && Model.Result.Success)
                {
                    <div class="alert alert-info">Preview based on current query result.</div>
                    <partial name="_VisualizationPreview" model="Model" />
                }
                else
                {
                    <div class="viz-preview-empty">
                        <div class="text-muted">Run a preview to see your chart here.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script>
        const autoRefreshToggle = document.getElementById('autoRefreshToggle');
        const autoRefreshInterval = document.getElementById('autoRefreshInterval');
        if (autoRefreshInterval) {
            const updateIntervalState = () => {
                autoRefreshInterval.disabled = !autoRefreshToggle.checked;
                if (!autoRefreshToggle.checked) {
                    autoRefreshInterval.value = '';
                }
            };
            updateIntervalState();
            autoRefreshToggle.addEventListener('change', updateIntervalState);
        }
    </script>
    <script>
        const typeSelect = document.getElementById('Type');
        const floatingToggle = document.getElementById('floatingBarsToggle');
        const floatingPanel = document.getElementById('floatingBarSettings');
        const horizontalToggle = document.getElementById('horizontalBarsToggle');
        const stackedToggle = document.getElementById('stackedBarsToggle');
        const yColumnsSelect = document.getElementById('yColumnsSelect');
        const lineInterpolationPanel = document.getElementById('lineInterpolationPanel');
        const lineInterpolationSelect = document.getElementById('lineInterpolationSelect');

        const updateFloatingState = () => {
            if (!typeSelect || !floatingPanel || !floatingToggle || !horizontalToggle || !stackedToggle) return;
            const type = typeSelect.value;
            const isBarFamily = type === 'Bar' || type === 'FloatingBar' || type === 'HorizontalBar';
            floatingPanel.classList.toggle('d-none', !isBarFamily);
            if (lineInterpolationPanel) {
                lineInterpolationPanel.classList.toggle('d-none', type !== 'Line');
                if (type !== 'Line' && lineInterpolationSelect) {
                    lineInterpolationSelect.value = 'default';
                }
            }
            if (!isBarFamily) {
                horizontalToggle.checked = false;
                horizontalToggle.disabled = false;
                stackedToggle.checked = false;
                stackedToggle.disabled = true;
                floatingToggle.checked = false;
                floatingToggle.disabled = false;
                if (yColumnsSelect) yColumnsSelect.disabled = false;
                return;
            }

            if (type === 'FloatingBar') {
                floatingToggle.checked = true;
                floatingToggle.disabled = true;
            } else {
                floatingToggle.disabled = false;
            }
            if (type === 'HorizontalBar') {
                horizontalToggle.checked = true;
                horizontalToggle.disabled = true;
            } else {
                horizontalToggle.disabled = false;
            }
            stackedToggle.disabled = false;
            if (yColumnsSelect) yColumnsSelect.disabled = floatingToggle.checked;
        };

        typeSelect?.addEventListener('change', updateFloatingState);
        floatingToggle?.addEventListener('change', updateFloatingState);
        horizontalToggle?.addEventListener('change', updateFloatingState);
        stackedToggle?.addEventListener('change', updateFloatingState);
        updateFloatingState();
    </script>
}
