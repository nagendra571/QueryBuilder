@model QueryBuilder.Web.Models.Visualizations.VisualizationEditViewModel

@{
    ViewData["Title"] = ViewData["Title"] as string ?? "New Visualization";
    var actionLabel = Model.Id.HasValue ? "Edit" : "New";
    var columns = Model.Columns.Count > 0
        ? Model.Columns
        : new List<string> { "?column?", "?column?1", "?column?2" };
}

<div class="viz-editor">
    <div class="viz-shell">
        <div class="viz-header">
            <div>
                <div class="h5 mb-0">@actionLabel Visualization</div>
                <div class="text-muted small">Query @Model.QueryId</div>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Id.HasValue && Model.CanDelete)
                {
                    <button class="btn btn-sm btn-outline-danger"
                            type="button"
                            id="deleteVisualizationBtn"
                            data-visualization-id="@Model.Id"
                            data-visualization-name="@Model.Name"
                            data-query-id="@Model.QueryId">
                        Delete
                    </button>
                }
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Queries" asp-action="Edit" asp-route-id="@Model.QueryId">Close</a>
            </div>
        </div>

        <div class="viz-body">
            <form method="post" class="viz-config viz-card">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="QueryId" />
                <input type="hidden" asp-for="LatestExecutionId" />
                <input type="hidden" asp-for="TableConfigJson" />
                <input type="hidden" asp-for="ChartConfigJson" />
                <input type="hidden" asp-for="CounterConfigJson" />

                <partial name="_VisualizationParameters" model="Model" />

                @if (Model.Result != null && !Model.Result.Success)
                {
                    if (Model.Result.ParameterErrors.Count > 0)
                    {
                        <div class="alert alert-warning">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in Model.Result.ParameterErrors)
                                {
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(error.Parameter))
                                        {
                                            <span>Parameter <strong>@error.Parameter</strong> @error.Message</span>
                                        }
                                        else
                                        {
                                            <span>@error.Message</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">@Model.Result.ErrorMessage</div>
                    }
                }

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" class="form-select" asp-items="ViewBag.VisualizationTypes"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="border rounded-3 p-3 bg-light mb-3" id="autoRefreshPanel">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsAutoRefreshEnabled" class="form-check-input" id="autoRefreshToggle" />
                        <label asp-for="IsAutoRefreshEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mb-2">
                        <label asp-for="AutoRefreshIntervalSeconds" class="form-label"></label>
                        <select asp-for="AutoRefreshIntervalSeconds" class="form-select" id="autoRefreshInterval">
                            <option value="">Select interval</option>
                            <option value="30">30 seconds</option>
                            <option value="60">1 minute</option>
                            <option value="300">5 minutes</option>
                            <option value="600">10 minutes</option>
                            <option value="1800">30 minutes</option>
                            <option value="3600">60 minutes</option>
                        </select>
                        <span asp-validation-for="AutoRefreshIntervalSeconds" class="text-danger"></span>
                    </div>
                    <div class="form-text text-warning">
                        Auto refresh may increase system load for complex queries.
                    </div>
                </div>

                <ul class="nav nav-tabs viz-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizGeneral" type="button" role="tab" data-viz-tab="chart">General</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizXAxis" type="button" role="tab" data-viz-tab="chart">X Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizYAxis" type="button" role="tab" data-viz-tab="chart">Y Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizSeries" type="button" role="tab" data-viz-tab="chart">Series</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizColors" type="button" role="tab" data-viz-tab="chart">Colors</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizDataLabels" type="button" role="tab" data-viz-tab="chart">Data Labels</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizCounterGeneral" type="button" role="tab" data-viz-tab="counter">General</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizCounterFormat" type="button" role="tab" data-viz-tab="counter">Format</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizTableColumns" type="button" role="tab" data-viz-tab="table">Columns</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizTableGrid" type="button" role="tab" data-viz-tab="table">Grid</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade" id="vizGeneral" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label" for="chartTypeSelect">Chart Type</label>
                            <select class="form-select" id="chartTypeSelect">
                                <option value="">Choose chart type...</option>
                                <option value="line">Line</option>
                                <option value="bar">Bar</option>
                                <option value="area">Area</option>
                                <option value="pie">Pie</option>
                                <option value="scatter">Scatter</option>
                                <option value="bubble">Bubble</option>
                                <option value="heatmap">Heatmap</option>
                                <option value="box">Box</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartXColumnSelect">X Column</label>
                            <select class="form-select" id="chartXColumnSelect">
                                <option value="">Choose column...</option>
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                            <div class="text-danger small d-none" id="chartXColumnError">X column is required.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartYColumnsSelect">Y Columns</label>
                            <select class="form-select" multiple size="6" id="chartYColumnsSelect">
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                            <div class="text-danger small d-none" id="chartYColumnsError">Select at least one Y column.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartGroupBySelect">Group By</label>
                            <select class="form-select" id="chartGroupBySelect">
                                <option value="">Choose column...</option>
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartErrorsSelect">Errors Column</label>
                            <select class="form-select" id="chartErrorsSelect">
                                <option value="">Choose column...</option>
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chartShowLegend">
                            <label class="form-check-label" for="chartShowLegend">Show Legend</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartStackingSelect">Stacking</label>
                            <select class="form-select" id="chartStackingSelect">
                                <option value="disabled">Disabled</option>
                                <option value="stack">Stack</option>
                            </select>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chartNormalizeToPercent">
                            <label class="form-check-label" for="chartNormalizeToPercent">Normalize values to percentage</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chartNullAsZero">
                            <label class="form-check-label" for="chartNullAsZero">Treat missing/null values as 0</label>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizXAxis" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label" for="chartXAxisScale">Scale</label>
                            <select class="form-select" id="chartXAxisScale">
                                <option value="auto">Auto Detect</option>
                                <option value="datetime">Datetime</option>
                                <option value="linear">Linear</option>
                                <option value="logarithmic">Logarithmic</option>
                                <option value="category">Category</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartXAxisName">Name</label>
                            <input class="form-control" id="chartXAxisName" type="text" />
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chartSortValues">
                            <label class="form-check-label" for="chartSortValues">Sort Values</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chartReverseOrder">
                            <label class="form-check-label" for="chartReverseOrder">Reverse Order</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chartShowLabels">
                            <label class="form-check-label" for="chartShowLabels">Show Labels</label>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizYAxis" role="tabpanel">
                        <div class="border rounded-3 p-3 bg-light mb-4">
                            <div class="fw-semibold mb-2">Left Y Axis</div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisLeftScale">Scale</label>
                                <select class="form-select" id="chartYAxisLeftScale">
                                    <option value="linear">Linear</option>
                                    <option value="logarithmic">Logarithmic</option>
                                    <option value="datetime">Datetime</option>
                                    <option value="category">Category</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisLeftName">Name</label>
                                <input class="form-control" id="chartYAxisLeftName" type="text" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisLeftMin">Min Value</label>
                                <input class="form-control" id="chartYAxisLeftMin" type="text" placeholder="Auto" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisLeftMax">Max Value</label>
                                <input class="form-control" id="chartYAxisLeftMax" type="text" placeholder="Auto" />
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chartYAxisLeftReverse">
                                <label class="form-check-label" for="chartYAxisLeftReverse">Reverse Order</label>
                            </div>
                        </div>
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="fw-semibold mb-2">Right Y Axis</div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisRightScale">Scale</label>
                                <select class="form-select" id="chartYAxisRightScale">
                                    <option value="linear">Linear</option>
                                    <option value="logarithmic">Logarithmic</option>
                                    <option value="datetime">Datetime</option>
                                    <option value="category">Category</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisRightName">Name</label>
                                <input class="form-control" id="chartYAxisRightName" type="text" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisRightMin">Min Value</label>
                                <input class="form-control" id="chartYAxisRightMin" type="text" placeholder="Auto" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="chartYAxisRightMax">Max Value</label>
                                <input class="form-control" id="chartYAxisRightMax" type="text" placeholder="Auto" />
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chartYAxisRightReverse">
                                <label class="form-check-label" for="chartYAxisRightReverse">Reverse Order</label>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizSeries" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="chartSeriesTable">
                                <thead>
                                <tr>
                                    <th style="width: 90px;">zIndex</th>
                                    <th style="width: 120px;">Left Y Axis</th>
                                    <th style="width: 120px;">Right Y Axis</th>
                                    <th>Label</th>
                                    <th style="width: 160px;">Type</th>
                                </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="text-muted d-none" id="chartSeriesEmpty">Run the query to load series.</div>
                    </div>
                    <div class="tab-pane fade" id="vizColors" role="tabpanel">
                        <div id="chartColorsList" class="d-flex flex-column gap-2"></div>
                        <div class="text-muted d-none" id="chartColorsEmpty">No series available.</div>
                    </div>
                    <div class="tab-pane fade" id="vizDataLabels" role="tabpanel">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chartDataLabelsEnabled">
                            <label class="form-check-label" for="chartDataLabelsEnabled">Show Data Labels</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartDataLabelsNumberFormat">Number Values Format</label>
                            <input class="form-control" id="chartDataLabelsNumberFormat" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartDataLabelsPercentFormat">Percent Values Format</label>
                            <input class="form-control" id="chartDataLabelsPercentFormat" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartDataLabelsDateFormat">Date/Time Values Format</label>
                            <input class="form-control" id="chartDataLabelsDateFormat" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="chartDataLabelsTemplate">Data Labels</label>
                            <input class="form-control" id="chartDataLabelsTemplate" type="text" placeholder="auto" />
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizCounterGeneral" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label" for="counterLabel">Counter Label</label>
                            <input class="form-control" id="counterLabel" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterValueColumn">Counter Value Column Name</label>
                            <select class="form-select" id="counterValueColumn">
                                <option value="">Choose column...</option>
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                            <div class="text-danger small d-none" id="counterValueColumnError">Counter value column is required.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterValueRow">Counter Value Row Number</label>
                            <input class="form-control" id="counterValueRow" type="number" min="1" />
                            <div class="text-danger small d-none" id="counterValueRowError">Row number must be at least 1.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterTargetColumn">Target Value Column Name</label>
                            <select class="form-select" id="counterTargetColumn">
                                <option value="">Choose column...</option>
                                @foreach (var column in columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterTargetRow">Target Value Row Number</label>
                            <input class="form-control" id="counterTargetRow" type="number" min="1" />
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="counterCountRows">
                            <label class="form-check-label" for="counterCountRows">Count Rows</label>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizCounterFormat" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label" for="counterNumberFormat">Number Format</label>
                            <input class="form-control" id="counterNumberFormat" type="text" />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="counterShowTarget">
                            <label class="form-check-label" for="counterShowTarget">Show Target</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterPrefix">Prefix</label>
                            <input class="form-control" id="counterPrefix" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterSuffix">Suffix</label>
                            <input class="form-control" id="counterSuffix" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterPositiveColor">Positive Color</label>
                            <select class="form-select" id="counterPositiveColor">
                                <option value="green">Green</option>
                                <option value="blue">Blue</option>
                                <option value="teal">Teal</option>
                                <option value="gray">Gray</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="counterNegativeColor">Negative Color</label>
                            <select class="form-select" id="counterNegativeColor">
                                <option value="red">Red</option>
                                <option value="orange">Orange</option>
                                <option value="gray">Gray</option>
                            </select>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizTableColumns" role="tabpanel">
                        <div class="mb-3">
                            <input class="form-control" id="tableColumnSearch" placeholder="Search columns..." />
                        </div>
                        <div class="alert alert-info d-none" id="tableColumnsEmptyState">
                            Run the query to configure columns.
                        </div>
                        <div class="text-muted d-none" id="tableColumnsNoMatch">No matching columns.</div>
                        <div id="tableColumnsList" class="viz-columns-strip"></div>
                    </div>
                    <div class="tab-pane fade" id="vizTableGrid" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label" for="tableGridPageSize">Rows per page</label>
                            <input class="form-control" id="tableGridPageSize" type="number" min="1" max="500" />
                            <div class="form-text">Controls pagination size for table results.</div>
                        </div>
                    </div>
                </div>

                <div class="viz-actions d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" type="submit" name="SubmitAction" value="preview">Preview</button>
                    <button class="btn btn-primary" type="submit" name="SubmitAction" value="save">Save</button>
                </div>
            </form>

            <div class="viz-preview viz-card">
                @if (Model.Result != null && !Model.Result.Success)
                {
                    if (Model.Result.ParameterErrors.Count > 0)
                    {
                        <div class="alert alert-warning">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in Model.Result.ParameterErrors)
                                {
                                    <li>
                                        @if (!string.IsNullOrWhiteSpace(error.Parameter))
                                        {
                                            <span>Parameter <strong>@error.Parameter</strong> @error.Message</span>
                                        }
                                        else
                                        {
                                            <span>@error.Message</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">@Model.Result.ErrorMessage</div>
                    }
                }
                else if (Model.Result != null && Model.Result.Success)
                {
                    <div class="alert alert-info">Preview based on current query result.</div>
                }
                <div id="tableVizPreview"
                     class="d-none"
                     data-allow-html-preview="@((User.IsInRole("Admin") || User.IsInRole("Editor")).ToString().ToLowerInvariant())">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="text-muted small" id="tablePreviewStatus">Page 1</div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 small">Rows per page</label>
                            <select class="form-select form-select-sm" id="tablePreviewPageSize">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="250">250</option>
                                <option value="500">500</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2 d-none" id="tablePreviewSearchWrap">
                        <input aria-label="Search table preview" class="form-control form-control-sm" id="tablePreviewSearch" placeholder="Search..." type="search" />
                    </div>
                    <div class="text-muted" id="tablePreviewLoading">Loading preview...</div>
                    <div id="tablePreviewTable"></div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" type="button" id="tablePreviewPrev">Prev</button>
                            <button class="btn btn-outline-secondary" type="button" id="tablePreviewNext">Next</button>
                        </div>
                        <div class="text-muted small" id="tablePreviewInfo"></div>
                    </div>
                </div>
                <div id="chartVizPreview" class="d-none">
                    <div class="viz-preview-empty d-none" id="chartPreviewEmpty">
                        <div class="text-muted">Run the query to see your chart here.</div>
                    </div>
                    <div id="chartPreviewLoading" class="text-muted small mb-2 d-none">Loading preview...</div>
                    <div id="chartPreviewErrors" class="text-danger small mb-2 d-none"></div>
                    <div id="chartPreviewWarnings" class="text-warning small mb-2 d-none"></div>
                    <partial name="_VisualizationPreview" model="Model" />
                </div>
                <div id="counterVizPreview" class="d-none">
                    <div class="viz-preview-empty d-none" id="counterPreviewEmpty">
                        <div class="text-muted">Run the query to see your counter here.</div>
                    </div>
                    <div id="counterPreviewLoading" class="text-muted small mb-2 d-none">Loading preview...</div>
                    <div id="counterPreviewErrors" class="text-danger small mb-2 d-none"></div>
                    <div id="counterPreviewWarnings" class="text-warning small mb-2 d-none"></div>
                    <div id="counterPreviewDisplay" class="counter-visualization"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Id.HasValue && Model.CanDelete)
{
    <div class="modal fade" id="deleteVisualizationModal" tabindex="-1" aria-labelledby="deleteVisualizationTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteVisualizationTitle">Delete visualization?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">This will remove the visualization from this query. This cannot be undone.</p>
                    <div class="alert alert-warning d-none" id="deleteVisualizationBlocked"></div>
                    <ul class="list-unstyled d-none" id="deleteVisualizationDashboards"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteVisualizationBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script src="~/js/chart-visualization-editor.js" asp-append-version="true"></script>
    <script src="~/js/counter-visualization-editor.js" asp-append-version="true"></script>
    <script src="~/js/table-visualization-editor.js" asp-append-version="true"></script>
    <script>
        const autoRefreshToggle = document.getElementById('autoRefreshToggle');
        const autoRefreshInterval = document.getElementById('autoRefreshInterval');
        if (autoRefreshInterval) {
            const updateIntervalState = () => {
                autoRefreshInterval.disabled = !autoRefreshToggle.checked;
                if (!autoRefreshToggle.checked) {
                    autoRefreshInterval.value = '';
                }
            };
            updateIntervalState();
            autoRefreshToggle.addEventListener('change', updateIntervalState);
        }
    </script>
    <script>
        const typeSelect = document.getElementById('Type');
        const chartPreview = document.getElementById('chartVizPreview');
        const counterPreview = document.getElementById('counterVizPreview');
        const tablePreview = document.getElementById('tableVizPreview');
        const chartTabs = document.querySelectorAll('[data-viz-tab="chart"]');
        const counterTabs = document.querySelectorAll('[data-viz-tab="counter"]');
        const tableTabs = document.querySelectorAll('[data-viz-tab="table"]');

        const setActiveTab = (targetId) => {
            const target = document.querySelector(`[data-bs-target='${targetId}']`);
            if (!target) return;
            document.querySelectorAll('.viz-tabs .nav-link').forEach((tab) => {
                tab.classList.toggle('active', tab === target);
            });
            document.querySelectorAll('.tab-content .tab-pane').forEach((pane) => {
                const isActive = `#${pane.id}` === targetId;
                pane.classList.toggle('show', isActive);
                pane.classList.toggle('active', isActive);
            });
        };

        const updateTabVisibility = () => {
            if (!typeSelect) return;
            const isTable = typeSelect.value === 'Table';
            const isCounter = typeSelect.value === 'Counter';
            chartTabs.forEach((tab) => tab.classList.toggle('d-none', isTable || isCounter));
            counterTabs.forEach((tab) => tab.classList.toggle('d-none', !isCounter));
            tableTabs.forEach((tab) => tab.classList.toggle('d-none', !isTable));
            if (chartPreview) {
                chartPreview.classList.toggle('d-none', isTable || isCounter);
            }
            if (counterPreview) {
                counterPreview.classList.toggle('d-none', !isCounter);
            }
            if (tablePreview) {
                tablePreview.classList.toggle('d-none', !isTable);
            }
            setActiveTab(isTable ? '#vizTableColumns' : isCounter ? '#vizCounterGeneral' : '#vizGeneral');
        };

        typeSelect?.addEventListener('change', updateTabVisibility);
        updateTabVisibility();
    </script>
    @if (Model.Id.HasValue && Model.CanDelete)
    {
        <script>
            (() => {
                const deleteBtn = document.getElementById('deleteVisualizationBtn');
                const modalEl = document.getElementById('deleteVisualizationModal');
                const confirmBtn = document.getElementById('confirmDeleteVisualizationBtn');
                const blockedAlert = document.getElementById('deleteVisualizationBlocked');
                const dashboardsList = document.getElementById('deleteVisualizationDashboards');
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!deleteBtn || !modalEl || !confirmBtn || !blockedAlert || !dashboardsList || !token) return;

                const modal = window.bootstrap?.Modal ? new bootstrap.Modal(modalEl) : null;
                const visualizationId = deleteBtn.dataset.visualizationId;
                const queryId = deleteBtn.dataset.queryId;

                const setBlockedState = (message, dashboards) => {
                    blockedAlert.textContent = message;
                    blockedAlert.classList.remove('d-none');
                    dashboardsList.innerHTML = '';
                    if (dashboards.length > 0) {
                        dashboardsList.classList.remove('d-none');
                        dashboards.slice(0, 5).forEach(name => {
                            const item = document.createElement('li');
                            item.textContent = name;
                            dashboardsList.appendChild(item);
                        });
                        if (dashboards.length > 5) {
                            const more = document.createElement('li');
                            more.textContent = `and ${dashboards.length - 5} more`;
                            dashboardsList.appendChild(more);
                        }
                    } else {
                        dashboardsList.classList.add('d-none');
                    }
                    confirmBtn.disabled = true;
                };

                const resetModal = () => {
                    blockedAlert.classList.add('d-none');
                    blockedAlert.textContent = '';
                    dashboardsList.classList.add('d-none');
                    dashboardsList.innerHTML = '';
                    confirmBtn.disabled = false;
                };

                deleteBtn.addEventListener('click', () => {
                    resetModal();
                    modal?.show();
                });

                confirmBtn.addEventListener('click', async () => {
                    if (!visualizationId) return;
                    confirmBtn.disabled = true;
                    try {
                        const response = await fetch(`/visualizations/${encodeURIComponent(visualizationId)}/delete`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token.value
                            }
                        });
                        if (!response.ok) {
                            setBlockedState('Unable to delete visualization.', []);
                            return;
                        }
                        const payload = await response.json();
                        if (!payload.success) {
                            const dashboards = Array.isArray(payload.affectedDashboards) ? payload.affectedDashboards : [];
                            const message = payload.message || 'Cannot delete visualization.';
                            setBlockedState(message, dashboards);
                            return;
                        }
                        if (queryId) {
                            window.location.href = `/Queries/Edit/${encodeURIComponent(queryId)}`;
                        } else {
                            window.location.reload();
                        }
                    } catch (err) {
                        setBlockedState('Unable to delete visualization.', []);
                    } finally {
                        confirmBtn.disabled = false;
                    }
                });
            })();
        </script>
    }
}
