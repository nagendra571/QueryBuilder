@model QueryBuilder.Web.Models.Visualizations.VisualizationEditViewModel

@{
    ViewData["Title"] = ViewData["Title"] as string ?? "New Visualization";
    var actionLabel = Model.Id.HasValue ? "Edit" : "New";
}

<div class="viz-editor">
    <div class="viz-shell">
        <div class="viz-header">
            <div>
                <div class="h5 mb-0">@actionLabel Visualization</div>
                <div class="text-muted small">Query @Model.QueryId</div>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Queries" asp-action="Edit" asp-route-id="@Model.QueryId">Close</a>
        </div>

        <div class="viz-body">
            <form method="post" class="viz-config viz-card">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="QueryId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <ul class="nav nav-tabs viz-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#vizGeneral" type="button" role="tab">General</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizXAxis" type="button" role="tab">X Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizYAxis" type="button" role="tab">Y Axis</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vizSeries" type="button" role="tab">Series</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="vizGeneral" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" class="form-select" asp-items="ViewBag.VisualizationTypes"></select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="ShowLegend" class="form-check-input" />
                            <label asp-for="ShowLegend" class="form-check-label"></label>
                        </div>
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsAutoRefreshEnabled" class="form-check-input" id="autoRefreshToggle" />
                                <label asp-for="IsAutoRefreshEnabled" class="form-check-label"></label>
                            </div>
                            <div class="mb-2">
                                <label asp-for="AutoRefreshIntervalSeconds" class="form-label"></label>
                                <select asp-for="AutoRefreshIntervalSeconds" class="form-select" id="autoRefreshInterval">
                                    <option value="">Select interval</option>
                                    <option value="30">30 seconds</option>
                                    <option value="60">1 minute</option>
                                    <option value="300">5 minutes</option>
                                    <option value="600">10 minutes</option>
                                    <option value="1800">30 minutes</option>
                                    <option value="3600">60 minutes</option>
                                </select>
                                <span asp-validation-for="AutoRefreshIntervalSeconds" class="text-danger"></span>
                            </div>
                            <div class="form-text text-warning">
                                Auto refresh may increase system load for complex queries.
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizXAxis" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="XColumn" class="form-label"></label>
                            <select asp-for="XColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="GroupByColumn" class="form-label"></label>
                            <select asp-for="GroupByColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                            <div class="form-text">Optional. Stored for future grouping logic.</div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizYAxis" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="YColumns" class="form-label"></label>
                            <select asp-for="YColumns" class="form-select" multiple size="6">
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column" selected="@(Model.YColumns.Contains(column) ? "selected" : null)">@column</option>
                                }
                            </select>
                            <div class="form-text">Select one or more series.</div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="vizSeries" role="tabpanel">
                        <div class="mb-3">
                            <label asp-for="LabelColumn" class="form-label"></label>
                            <select asp-for="LabelColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ValueColumn" class="form-label"></label>
                            <select asp-for="ValueColumn" class="form-select">
                                <option value="">--</option>
                                @foreach (var column in Model.Columns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="viz-actions d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" type="submit" name="SubmitAction" value="preview">Preview</button>
                    <button class="btn btn-primary" type="submit" name="SubmitAction" value="save">Save</button>
                </div>
            </form>

            <div class="viz-preview viz-card">
                @if (Model.Result != null && Model.Result.Success)
                {
                    <div class="alert alert-info">Preview based on current query result.</div>
                    <partial name="_VisualizationPreview" model="Model" />
                }
                else
                {
                    <div class="viz-preview-empty">
                        <div class="text-muted">Run a preview to see your chart here.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script>
        const autoRefreshToggle = document.getElementById('autoRefreshToggle');
        const autoRefreshInterval = document.getElementById('autoRefreshInterval');
        if (autoRefreshInterval) {
            const updateIntervalState = () => {
                autoRefreshInterval.disabled = !autoRefreshToggle.checked;
                if (!autoRefreshToggle.checked) {
                    autoRefreshInterval.value = '';
                }
            };
            updateIntervalState();
            autoRefreshToggle.addEventListener('change', updateIntervalState);
        }
    </script>
}
