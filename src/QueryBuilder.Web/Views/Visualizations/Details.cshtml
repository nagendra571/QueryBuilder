@model QueryBuilder.Web.Models.Visualizations.VisualizationDetailsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Visualization.Name;
    var dataJson = JsonSerializer.Serialize(Model.Result.Rows);
    var columnsJson = JsonSerializer.Serialize(Model.Result.Columns);
    var tableConfigJson = JsonSerializer.Serialize(
        Model.TableConfig ?? new QueryBuilder.Web.Models.Visualizations.TableVisualizationConfig(),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

    <div class="viz-details-header d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">@Model.Visualization.Name</h1>
            <div class="text-muted">Query: @Model.QueryName</div>
        </div>
        <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#addToDashboardModal">
            Add to Dashboard
        </button>
        <a class="btn btn-outline-primary" asp-controller="Visualizations" asp-action="Edit" asp-route-id="@Model.Visualization.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-controller="Queries" asp-action="Edit" asp-route-id="@Model.Visualization.QueryId">Back to Query</a>
    </div>
</div>

@if (!Model.Result.Success)
{
    if (Model.Result.ParameterErrors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Result.ParameterErrors)
                {
                    <li>
                        @if (!string.IsNullOrWhiteSpace(error.Parameter))
                        {
                            <span>Parameter <strong>@error.Parameter</strong> @error.Message</span>
                        }
                        else
                        {
                            <span>@error.Message</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-danger">@Model.Result.ErrorMessage</div>
    }
}
else
{
    @if (Model.Visualization.Type == QueryBuilder.Domain.Entities.VisualizationType.Table)
    {
        <div class="card viz-card" id="viz-details-container" data-visualization-id="@Model.Visualization.Id" data-visualization-type="@Model.Visualization.Type">
            <div class="p-3"
                 data-paged-table="true"
                 data-endpoint="/visualizations/@Model.Visualization.Id/results"
                 data-storage-key="vizView.pageSize"
                 data-table-config="@tableConfigJson"
                 data-allow-unsafe-html="@((User.IsInRole("Admin") || User.IsInRole("Editor")).ToString().ToLowerInvariant())">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="text-muted small" data-page-status>Page 1</div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 small">Rows per page</label>
                        <select class="form-select form-select-sm" data-page-size>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500">500</option>
                        </select>
                    </div>
                </div>
                <div class="text-muted" data-page-loading>Loading results...</div>
                <div data-page-table></div>
                <div class="d-flex justify-content-between align-items-center mt-2" data-page-controls>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" type="button" data-page-prev>Prev</button>
                        <button class="btn btn-outline-secondary" type="button" data-page-next>Next</button>
                    </div>
                    <div class="text-muted small" data-page-info></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card viz-card mb-3" id="viz-details-container" data-visualization-id="@Model.Visualization.Id" data-visualization-type="@Model.Visualization.Type">
            <div class="card-body">
                <canvas id="vizChart" height="120"></canvas>
            </div>
        </div>
    }
}

@if (Model.Visualization.Type != QueryBuilder.Domain.Entities.VisualizationType.Table)
{
    <script>
        window.queryBuilderViz = window.queryBuilderViz || {};
        window.queryBuilderViz.details = {
            type: "@Model.Visualization.Type",
            columns: @Html.Raw(columnsJson),
            rows: @Html.Raw(dataJson),
            xColumn: "@(Model.Config.XColumn ?? string.Empty)",
            yColumn: "@(Model.Config.YColumn ?? string.Empty)",
            yColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Config.YColumns)),
            useHorizontalBars: @Model.Config.UseHorizontalBars.ToString().ToLowerInvariant(),
            useStackedBars: @Model.Config.UseStackedBars.ToString().ToLowerInvariant(),
            useFloatingBars: @Model.Config.UseFloatingBars.ToString().ToLowerInvariant(),
            rangeStartColumn: "@(Model.Config.RangeStartColumn ?? string.Empty)",
            rangeEndColumn: "@(Model.Config.RangeEndColumn ?? string.Empty)",
            labelColumn: "@(Model.Config.LabelColumn ?? string.Empty)",
            valueColumn: "@(Model.Config.ValueColumn ?? string.Empty)",
            showLegend: @Model.Config.ShowLegend.ToString().ToLowerInvariant(),
            lineInterpolationMode: "@(Model.Config.LineInterpolationMode ?? "default")"
        };
    </script>
}
else
{
    <script>
        window.queryBuilderTable = window.queryBuilderTable || {};
        window.queryBuilderTable.details = {
            columns: @Html.Raw(columnsJson),
            rows: @Html.Raw(dataJson),
            config: @Html.Raw(tableConfigJson),
            allowUnsafeHtml: @((User.IsInRole("Admin") || User.IsInRole("Editor")).ToString().ToLowerInvariant())
        };
    </script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
    <script src="~/js/table-visualization-renderer.js" asp-append-version="true"></script>
    <script src="~/js/paged-results.js" asp-append-version="true"></script>
    <script>
        window.autoRefreshConfig = {
            mode: "visualization",
            visualizationId: @Model.Visualization.Id,
            autoRefreshEnabled: @Model.Visualization.IsAutoRefreshEnabled.ToString().ToLowerInvariant(),
            autoRefreshInterval: @(Model.Visualization.AutoRefreshIntervalSeconds ?? 0),
            endpoint: `/visualizations/data/@Model.Visualization.Id`
        };
    </script>
    <script src="~/js/auto-refresh.js" asp-append-version="true"></script>
}

<div class="modal fade" id="addToDashboardModal" tabindex="-1" aria-labelledby="addToDashboardLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="AddToDashboard">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VisualizationId" value="@Model.Visualization.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addToDashboardLabel">Add to Dashboard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Select dashboard</label>
                    <select class="form-select" name="DashboardId" required>
                        <option value="">Choose...</option>
                        @foreach (var dashboard in Model.Dashboards)
                        {
                            <option value="@dashboard.Value">@dashboard.Text</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
