@model QueryBuilder.Web.Models.Visualizations.VisualizationDetailsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Visualization.Name;
    var dataJson = JsonSerializer.Serialize(Model.Result.Rows);
    var columnsJson = JsonSerializer.Serialize(Model.Result.Columns);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <a class="btn btn-link px-0" asp-controller="Queries" asp-action="Edit" asp-route-id="@Model.Visualization.QueryId">Back to Query</a>
        <h1 class="h3 mb-0">@Model.Visualization.Name</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Visualization.Id">Edit Visualization</a>
</div>

@if (!Model.Result.Success)
{
    <div class="alert alert-danger">@Model.Result.ErrorMessage</div>
}
else
{
    <div class="card">
        <div class="card-body">
            @if (Model.Visualization.Type == QueryBuilder.Domain.Entities.VisualizationType.Table)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover mb-0">
                        <thead class="bg-light">
                        <tr>
                            @foreach (var column in Model.Result.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Result.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@Model.Result.Columns.Count" class="text-muted text-center">No rows returned.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var row in Model.Result.Rows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td>@cell</td>
                                    }
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <canvas id="vizChart" height="120"></canvas>
            }
        </div>
    </div>
}

@if (Model.Visualization.Type != QueryBuilder.Domain.Entities.VisualizationType.Table)
{
    <script>
        window.queryBuilderViz = window.queryBuilderViz || {};
        window.queryBuilderViz.details = {
            type: "@Model.Visualization.Type",
            columns: @Html.Raw(columnsJson),
            rows: @Html.Raw(dataJson),
            xColumn: "@(Model.Config.XColumn ?? string.Empty)",
            yColumn: "@(Model.Config.YColumn ?? string.Empty)",
            yColumns: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Config.YColumns)),
            labelColumn: "@(Model.Config.LabelColumn ?? string.Empty)",
            valueColumn: "@(Model.Config.ValueColumn ?? string.Empty)",
            showLegend: @Model.Config.ShowLegend.ToString().ToLowerInvariant()
        };
    </script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/visualizations.js" asp-append-version="true"></script>
}
