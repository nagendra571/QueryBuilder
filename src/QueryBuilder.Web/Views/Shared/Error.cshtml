@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state">
    <div class="empty-state-icon text-danger">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <div class="empty-state-title">Something went wrong</div>
    <div class="empty-state-text">We couldn't process your request. Try refreshing or come back later.</div>
    @if (Model.ShowRequestId)
    {
        <div class="mt-3 small text-muted">Request ID: <code>@Model.RequestId</code></div>
    }
</div>
