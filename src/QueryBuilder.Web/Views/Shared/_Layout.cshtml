@inject QueryBuilder.Web.Services.IFeatureFlagService FeatureFlags
@{
    var newAppearance = await FeatureFlags.IsEnabledAsync("NewAppearance");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QueryBuilder</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (newAppearance)
    {
        <link rel="stylesheet" href="~/css/theme.compact.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/QueryBuilder.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-shell @(newAppearance ? "theme-compact" : "")">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    }
    <header class="app-header">
        <div class="app-header-left">
            <button class="btn btn-outline-secondary d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                <span class="bi bi-list"></span>
            </button>
            <a class="app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/qb-logo.svg" alt="QueryBuilder" class="app-logo">
            </a>
        </div>
        <div class="app-header-center">
            <div class="app-page-title">@ViewData["Title"]</div>
        </div>
        <div class="app-header-right">
            <partial name="_LoginPartial" />
        </div>
    </header>
    <div class="app-body">
        <aside class="app-sidebar sidebar">
            <div class="sidebar-inner">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Queries" ? "active" : "")" asp-area="" asp-controller="Queries" asp-action="Index">
                            <span class="sidebar-icon bi bi-code-square"></span>
                            <span class="sidebar-label">Queries</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Dashboards" ? "active" : "")" asp-area="" asp-controller="Dashboards" asp-action="Index">
                            <span class="sidebar-icon bi bi-grid-1x2"></span>
                            <span class="sidebar-label">Dashboards</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item mt-3 text-uppercase small text-muted ps-3">Admin</li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "DataSources" ? "active" : "")" asp-area="" asp-controller="DataSources" asp-action="Index">
                                <span class="sidebar-icon bi bi-database"></span>
                                <span class="sidebar-label">Data Sources</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Users">
                                <span class="sidebar-icon bi bi-people"></span>
                                <span class="sidebar-label">Users</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Groups" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Groups">
                                <span class="sidebar-icon bi bi-people-fill"></span>
                                <span class="sidebar-label">Groups</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "FeatureFlags" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="FeatureFlags">
                                <span class="sidebar-icon bi bi-sliders"></span>
                                <span class="sidebar-label">Feature Flags</span>
                            </a>
                        </li>
                    }
                </ul>
                <div class="sidebar-footer mt-auto">
                    <button class="btn btn-light w-100 sidebar-toggle" type="button" id="sidebarToggle">
                        <span class="sidebar-toggle-icon bi bi-chevron-left"></span>
                        <span class="sidebar-label">Collapse</span>
                    </button>
                </div>
            </div>
        </aside>
        <main class="app-content main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Queries" asp-action="Index">
                        <span class="sidebar-icon bi bi-code-square"></span>
                        <span class="sidebar-label">Queries</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Dashboards" asp-action="Index">
                        <span class="sidebar-icon bi bi-grid-1x2"></span>
                        <span class="sidebar-label">Dashboards</span>
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item mt-2 text-uppercase small text-muted ps-3">Admin</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="DataSources" asp-action="Index">
                            <span class="sidebar-icon bi bi-database"></span>
                            <span class="sidebar-label">Data Sources</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users">
                            <span class="sidebar-icon bi bi-people"></span>
                            <span class="sidebar-label">Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Groups">
                            <span class="sidebar-icon bi bi-people-fill"></span>
                            <span class="sidebar-label">Groups</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="FeatureFlags">
                            <span class="sidebar-icon bi bi-sliders"></span>
                            <span class="sidebar-label">Feature Flags</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    @if (TempData["StatusMessage"] is string toastMessage)
    {
        <div data-toast-message="@toastMessage" data-toast-level="info" id="toastSeed"></div>
    }

    <footer class="app-footer">
        &copy; 2026 - QueryBuilder
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
