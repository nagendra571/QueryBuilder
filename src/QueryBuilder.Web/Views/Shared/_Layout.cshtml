<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QueryBuilder</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enhancement.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QueryBuilder.Web.styles.css" asp-append-version="true" />
</head>
<body class="app">
    <header class="app-header">
        <div class="app-header-brand">
            <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/favicon.ico" alt="QueryBuilder" width="30" height="30" class="d-inline-block align-text-top">
                QueryBuilder
            </a>
        </div>
        <div class="app-header-page-title">
            <h1 class="h4 mb-0 text-truncate">@ViewData["Title"]</h1>
        </div>
        <div class="app-header-content">
            <div class="app-header-actions">
                <partial name="_LoginPartial" />
            </div>
        </div>
        <button class="btn btn-outline-secondary d-lg-none ms-auto me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
            <span class="bi bi-list"></span>
        </button>
    </header>
    <div class="app-body">
        <aside class="app-sidebar">
            <div class="app-sidebar-inner">
                <ul class="app-sidebar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "Queries" ? "active" : "")" asp-area="" asp-controller="Queries" asp-action="Index">
                            <span class="sidebar-icon bi bi-code-square"></span>
                            <span class="sidebar-label">Queries</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "Dashboards" ? "active" : "")" asp-area="" asp-controller="Dashboards" asp-action="Index">
                            <span class="sidebar-icon bi bi-grid-1x2"></span>
                            <span class="sidebar-label">Dashboards</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item-header">Admin</li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"] as string == "DataSources" ? "active" : "")" asp-area="" asp-controller="DataSources" asp-action="Index">
                                <span class="sidebar-icon bi bi-database"></span>
                                <span class="sidebar-label">Data Sources</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"] as string == "Users" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Users">
                                <span class="sidebar-icon bi bi-people"></span>
                                <span class="sidebar-label">Users</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"] as string == "Groups" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Groups">
                                <span class="sidebar-icon bi bi-people-fill"></span>
                                <span class="sidebar-label">Groups</span>
                            </a>
                        </li>
                    }
                </ul>
                <div class="app-sidebar-footer">
                    <button class="btn btn-light w-100 sidebar-toggle" type="button" id="sidebarToggle">
                        <span class="sidebar-toggle-icon bi bi-chevron-left"></span>
                        <span class="sidebar-label">Collapse</span>
                    </button>
                </div>
            </div>
        </aside>
        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Queries" asp-action="Index">
                        <span class="sidebar-icon bi bi-code-square"></span>
                        <span class="sidebar-label">Queries</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Dashboards" asp-action="Index">
                        <span class="sidebar-icon bi bi-grid-1x2"></span>
                        <span class="sidebar-label">Dashboards</span>
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item mt-2 text-uppercase small text-muted ps-3">Admin</li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="DataSources" asp-action="Index">
                            <span class="sidebar-icon bi bi-database"></span>
                            <span class="sidebar-label">Data Sources</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users">
                            <span class="sidebar-icon bi bi-people"></span>
                            <span class="sidebar-label">Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Groups">
                            <span class="sidebar-icon bi bi-people-fill"></span>
                            <span class="sidebar-label">Groups</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    @if (TempData["StatusMessage"] is string toastMessage)
    {
        <div data-toast-message="@toastMessage" data-toast-level="info" id="toastSeed"></div>
    }

    <footer class="app-footer">
        &copy; 2026 - QueryBuilder
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/enhancement.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
