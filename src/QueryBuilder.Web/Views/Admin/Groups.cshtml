@model QueryBuilder.Web.Models.Admin.GroupsViewModel

@{
    ViewData["Title"] = "Groups";
}

<h1 class="h3 mb-3">Groups</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info">@statusMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="post" asp-action="CreateGroup" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <input class="form-control" name="NewGroupName" placeholder="New group name" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">Create Group</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Groups.Count == 0)
{
    <div class="text-muted">No groups created yet.</div>
}
else
{
    <div class="accordion" id="groupList">
        @for (var i = 0; i < Model.Groups.Count; i++)
        {
            var group = Model.Groups[i];
            var headingId = $"groupHeading{i}";
            var collapseId = $"groupCollapse{i}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        @group.Name
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#groupList">
                    <div class="accordion-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="text-muted">Members: @group.Members.Count</div>
                            <form method="post" asp-action="DeleteGroup">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="groupId" value="@group.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete Group</button>
                            </form>
                        </div>

                        <form method="post" asp-action="AddGroupMember" class="row g-2 mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="groupId" value="@group.Id" />
                            <div class="col-md-8">
                                <select class="form-select" name="userId">
                                    <option value="">Select user</option>
                                    @foreach (var user in Model.Users)
                                    {
                                        <option value="@user.Value">@user.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-primary w-100" type="submit">Add Member</button>
                            </div>
                        </form>

                        @if (group.Members.Count == 0)
                        {
                            <div class="text-muted">No members yet.</div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var member in group.Members)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@member.UserName</span>
                                        <form method="post" asp-action="RemoveGroupMember">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="memberId" value="@member.Id" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
